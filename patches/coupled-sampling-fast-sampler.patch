+        return;
+    }
+    const uint64_t salt = gsmpl->f18_salt ^ stream;
+    double  best   = -INFINITY;
+    int64_t best_i = -1;
+    for (size_t i = 0; i < cur_p.size; ++i) {
+        const float l = cur_p.data[i].logit;
+        if (!(l > -INFINITY)) {
+            continue;
+        }
