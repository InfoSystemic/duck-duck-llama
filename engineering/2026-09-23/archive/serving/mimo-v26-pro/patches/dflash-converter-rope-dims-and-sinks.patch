@@ -678,6 +678,16 @@ class DFlashModel(Qwen3Model):
     def set_gguf_parameters(self):
         super().set_gguf_parameters()
 
+        # MiMo's DFlash sets partial_rotary_factor 0.5 on a head_dim of 128, i.e. only 64 of the 128 dimensions carry
+        # positional information. Nothing upstream of here emits rope.dimension_count for this path, and llama.cpp then
+        # defaults n_rot to the full head dim -- so every position in the drafter is encoded wrong while the target is
+        # untouched, which looks exactly like a weak drafter. Measured effect: draft acceptance stuck at 3-8%.
+        head_dim = self.hparams.get("head_dim") or (self.hparams["hidden_size"] // self.hparams["num_attention_heads"])
+        rope_dim = int(head_dim * self.hparams.get("partial_rotary_factor", 1.0))
+        self.gguf_writer.add_rope_dimension_count(rope_dim)
+        logger.info(f"DFlash: rope dimension count = {rope_dim} (head_dim {head_dim} x partial_rotary_factor "
+                    f"{self.hparams.get('partial_rotary_factor', 1.0)})")
+
         block_size = self.hparams.get("block_size", 16)
         self.gguf_writer.add_block_size(block_size)
         dflash_config = self.hparams.get("dflash_config", {})
@@ -706,7 +716,14 @@ class DFlashModel(Qwen3Model):
         if name == "model.embed_tokens.weight" and not self.hparams.get("has_embed_tokens", True):
             return
 
-        yield from super().modify_tensors(data_torch, name, bid)
+        for new_name, tensor in super().modify_tensors(data_torch, name, bid):
+            # The attention sink arrives as "...self_attn.attention_sink_bias", whose name ends in "_bias" rather than
+            # ".bias", so no suffix is stripped and the mapper emits a bare "blk.N.attn_sinks". The dflash loader asks
+            # for tn(LLM_TENSOR_ATTN_SINKS, "weight", il), i.e. "blk.N.attn_sinks.weight", and a required tensor that is
+            # never claimed fails the load with "wrong number of tensors" -- after the 500 GiB target has already loaded.
+            if new_name.endswith(".attn_sinks"):
+                new_name += ".weight"
+            yield new_name, tensor
 
 
