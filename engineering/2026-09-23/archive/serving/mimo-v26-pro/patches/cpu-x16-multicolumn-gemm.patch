+// Split `total` activation rows into the fewest calls of at most `wmax` columns, as EVENLY as possible: a thin tail
+// call (e.g. 8 + 3 for an expert's 11 tokens) repeats the whole weight load/decode for a few columns. Measured
+// (x16-gemm-bench): MXFP4 at 11 tokens/expert 2483 -> 2888 GOPS, dense Q8_0 512 columns 3223 -> 3361. Only call
+// boundaries move, so the output is bit-identical. GGML_CPU_X16_GEMM_WMAX overrides the per-type width.
+static inline int ggml_x16_gemm_width(int64_t total, int64_t done, int wmax) {
+    static const int wmax_env = [] { const char * v = getenv("GGML_CPU_X16_GEMM_WMAX"); return v ? atoi(v) : 0; }();
+    if (wmax_env > 0) wmax = std::min(wmax_env, 12);
+    const int64_t ncall = (total + wmax - 1) / wmax;
+    const int64_t base  = total / ncall, extra = total % ncall;
+    // calls 0..extra-1 are one wider; find which call starts at `done`
+    const int64_t wide_span = extra * (base + 1);
+    return (int) (done < wide_span ? base + 1 : base);
+}
