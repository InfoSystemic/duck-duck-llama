+
+// ---- multi-column x16 kernels for prompt batches ----------------------------------------------------------------
+// Up to 8 activation rows per call, passed as pointer arrays because MoE token rows are not contiguous. Every weight
+// vector that is loaded -- and for MXFP4, LUT-decoded -- is reused for all of them, where the GEMV above reloads it
+// once per activation row; that is what held prompt processing near L2 bandwidth (~13% of VNNI peak). For each
+// (row, column) the float operations are exactly the GEMV's, in the same order, and the integer dot products are
+// exact in any order, so the output is bit-identical to calling the GEMV once per column.
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+static inline void ggml_x16_col_prep(const block_q8_0 * y, int nb, int32_t * ysum, float * yd) {
+    for (int b = 0; b < nb; b++) {
+        const __m256i q = _mm256_loadu_si256((const __m256i *) y[b].qs);
+        const __m512i w = _mm512_cvtepi8_epi16(q);
+        const __m256i lo = _mm512_castsi512_si256(w), hi = _mm512_extracti64x4_epi64(w, 1);
+        ysum[b] = _mm512_reduce_add_epi32(_mm512_cvtepi16_epi32(_mm256_add_epi16(lo, hi)));
+        yd[b] = GGML_CPU_FP16_TO_FP32(y[b].d);
+    }
+}
+
+template <int NR>
+static void ggml_x16_gemm_q8_0_nr(int nb, float * const * outs, const block_q8_0 * const * y, const block_q8_0_x16 * vxb,
+                                  int nc, const int32_t * const * ysum, const float * const * yd) {
+    for (int g = 0; g < nc / 16; g++) {
+        const block_q8_0_x16 * bp = vxb + (size_t) g * nb;
+        __m512 accf[NR];
+        for (int j = 0; j < NR; j++) accf[j] = _mm512_setzero_ps();
+        for (int b = 0; b < nb; b++) {
+            __m512i acc[NR];
+            for (int j = 0; j < NR; j++) acc[j] = _mm512_setzero_si512();
+            const uint8_t * q0 = bp[b].qs;
+            for (int i0 = 0; i0 < 8; i0++) {
+                const __m512i w = _mm512_loadu_si512((const void *)(q0 + i0 * 64));
+                for (int j = 0; j < NR; j++) acc[j] = _mm512_dpbusd_epi32(acc[j], w, GGML_X16_BC32(y[j][b].qs + 4*i0));
+            }
+            const __m512 dw = _mm512_cvtph_ps(_mm256_loadu_si256((const __m256i *) bp[b].d));
+            for (int j = 0; j < NR; j++) {
+                const __m512i a = _mm512_sub_epi32(acc[j], _mm512_set1_epi32(128 * ysum[j][b]));
+                accf[j] = _mm512_fmadd_ps(_mm512_cvtepi32_ps(a), _mm512_mul_ps(dw, _mm512_set1_ps(yd[j][b])), accf[j]);
+            }
+        }
+        for (int j = 0; j < NR; j++) _mm512_storeu_ps(outs[j] + g * 16, accf[j]);
+    }
+}
+
+template <int NR>
+static void ggml_x16_gemm_mxfp4_nr(int nb, float * const * outs, const block_q8_0 * const * y, const block_mxfp4_x16 * vxb,
+                                   int nc, const int32_t * const * ysum, const float * const * yd) {
+    alignas(16) uint8_t lut16[16];
+    for (int i = 0; i < 16; i++) lut16[i] = (uint8_t) ((int) kvalues_mxfp4[i] + 12);
+    const __m512i lut = _mm512_broadcast_i32x4(_mm_loadu_si128((const __m128i *) lut16));
+    const __m512i m4  = _mm512_set1_epi8(0x0F);
+    for (int g = 0; g < nc / 16; g++) {
+        const block_mxfp4_x16 * bp = vxb + (size_t) g * nb;
+        __m512 accf[NR];
+        for (int j = 0; j < NR; j++) accf[j] = _mm512_setzero_ps();
+        for (int b = 0; b < nb; b++) {
+            __m512i acc[NR];
+            for (int j = 0; j < NR; j++) acc[j] = _mm512_setzero_si512();
+            const uint8_t * q0 = bp[b].qs;
+            for (int i0 = 0; i0 < 4; i0++) {
+                const __m512i w  = _mm512_loadu_si512((const void *)(q0 + i0 * 64));
+                const __m512i lo = _mm512_shuffle_epi8(lut, _mm512_and_si512(w, m4));
+                const __m512i hi = _mm512_shuffle_epi8(lut, _mm512_and_si512(_mm512_srli_epi16(w, 4), m4));
+                for (int j = 0; j < NR; j++) {
+                    acc[j] = _mm512_dpbusd_epi32(acc[j], lo, GGML_X16_BC32(y[j][b].qs + 4*i0));
+                    acc[j] = _mm512_dpbusd_epi32(acc[j], hi, GGML_X16_BC32(y[j][b].qs + 16 + 4*i0));
+                }
+            }
+            // E8M0 -> 0.5 * 2^(e-127), vectorised with ggml_e8m0_to_fp32_half's exact bit formula (the table the GEMV
+            // reads is filled from it): (e-1) << 23, or the denormal 0x00200000 << e for e < 2
+            const __m512i ev  = _mm512_cvtepu8_epi32(_mm_loadu_si128((const __m128i *) bp[b].e));
+            const __m512i nrm = _mm512_slli_epi32(_mm512_sub_epi32(ev, _mm512_set1_epi32(1)), 23);
+            const __m512i den = _mm512_sllv_epi32(_mm512_set1_epi32(0x00200000), ev);
+            const __m512 scv  = _mm512_castsi512_ps(_mm512_mask_blend_epi32(_mm512_cmplt_epu32_mask(ev, _mm512_set1_epi32(2)), nrm, den));
+            for (int j = 0; j < NR; j++) {
+                const __m512i a = _mm512_sub_epi32(acc[j], _mm512_set1_epi32(12 * ysum[j][b]));
+                accf[j] = _mm512_fmadd_ps(_mm512_cvtepi32_ps(a), _mm512_mul_ps(scv, _mm512_set1_ps(yd[j][b])), accf[j]);
+            }
+        }
+        for (int j = 0; j < NR; j++) _mm512_storeu_ps(outs[j] + g * 16, accf[j]);
+    }
+}
+
+// up to GGML_X16_GEMM_NR_MAX (12) columns per call: an expert's ~11 prompt tokens fit in one call, so its weights are
+// loaded -- and for MXFP4 decoded -- once instead of twice (8 + 3)
+template <typename W, template <int> class KK>
+static void ggml_x16_gemm_dispatch(int n, int blck, int nr, float * const * outs, const void * const * ys, const void * vx, int nc,
+                                   const int32_t * const * ysums, const float * const * yds) {
+    const int nb = n / blck;
+    const block_q8_0 * y[16];
+    const int32_t * ysp[16];
+    const float * ydp[16];
+    int32_t ysum_stack[12 * 512]; float yd_stack[12 * 512];
+    std::vector<int32_t> ysum_heap; std::vector<float> yd_heap;
+    for (int j = 0; j < nr; j++) {
+        y[j] = (const block_q8_0 *) ys[j];
+    }
+    if (ysums != nullptr && yds != nullptr) {
+        for (int j = 0; j < nr; j++) { ysp[j] = ysums[j]; ydp[j] = yds[j]; }
+    } else {
+        int32_t * ysum = ysum_stack; float * yd = yd_stack;
+        if (nb > 512) { ysum_heap.resize((size_t) 12 * nb); yd_heap.resize((size_t) 12 * nb); ysum = ysum_heap.data(); yd = yd_heap.data(); }
+        for (int j = 0; j < nr; j++) {
+            ggml_x16_col_prep(y[j], nb, ysum + j*nb, yd + j*nb);
+            ysp[j] = ysum + j*nb; ydp[j] = yd + j*nb;
+        }
+    }
+    const W * w = (const W *) vx;
+    switch (nr) {
+        case 1:  KK<1>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 2:  KK<2>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 3:  KK<3>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 4:  KK<4>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 5:  KK<5>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 6:  KK<6>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 7:  KK<7>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 8:  KK<8>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 9:  KK<9>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 10: KK<10>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        case 11: KK<11>::run(nb, outs, y, w, nc, ysp, ydp); break;
+        default: KK<12>::run(nb, outs, y, w, nc, ysp, ydp); break;
+    }
+}
+template <int NR> struct ggml_x16_q8_0_k  { static void run(int nb, float * const * o, const block_q8_0 * const * y, const block_q8_0_x16 * w, int nc, const int32_t * const * s, const float * const * d) { ggml_x16_gemm_q8_0_nr<NR>(nb, o, y, w, nc, s, d); } };
+template <int NR> struct ggml_x16_mxfp4_k { static void run(int nb, float * const * o, const block_q8_0 * const * y, const block_mxfp4_x16 * w, int nc, const int32_t * const * s, const float * const * d) { ggml_x16_gemm_mxfp4_nr<NR>(nb, o, y, w, nc, s, d); } };
+#endif
+
+void ggml_x16_q8_0_col_prep(const void * y, int nb, int32_t * ysum, float * yd) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+    ggml_x16_col_prep((const block_q8_0 *) y, nb, ysum, yd);
+#else
+    const block_q8_0 * yb = (const block_q8_0 *) y;
+    for (int b = 0; b < nb; b++) {
+        int32_t sum = 0;
+        for (int i = 0; i < QK8_0; i++) sum += yb[b].qs[i];
+        ysum[b] = sum;
+        yd[b] = GGML_CPU_FP16_TO_FP32(yb[b].d);
+    }
+#endif
+}
+
+void ggml_gemm_ptrs_q8_0_x16_q8_0(int n, int nr, float * const * outs, const void * const * ys, const void * vx, int nc,
+                                  const int32_t * const * ysums, const float * const * yds) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+    GGML_ASSERT(nr >= 1 && nr <= 12 && n % QK8_0 == 0 && nc % 16 == 0);
+    ggml_x16_gemm_dispatch<block_q8_0_x16, ggml_x16_q8_0_k>(n, QK8_0, nr, outs, ys, vx, nc, ysums, yds);
+    return;
+#endif
+    GGML_UNUSED(ysums); GGML_UNUSED(yds);
+    for (int j = 0; j < nr; j++) ggml_gemv_q8_0_x16_q8_0(n, outs[j], 0, vx, ys[j], 1, nc);
+}
+
+void ggml_gemm_ptrs_mxfp4_x16_q8_0(int n, int nr, float * const * outs, const void * const * ys, const void * vx, int nc,
+                                   const int32_t * const * ysums, const float * const * yds) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+    GGML_ASSERT(nr >= 1 && nr <= 12 && n % QK_MXFP4 == 0 && nc % 16 == 0);
+    ggml_x16_gemm_dispatch<block_mxfp4_x16, ggml_x16_mxfp4_k>(n, QK_MXFP4, nr, outs, ys, vx, nc, ysums, yds);
+    return;
+#endif
+    GGML_UNUSED(ysums); GGML_UNUSED(yds);
+    for (int j = 0; j < nr; j++) ggml_gemv_mxfp4_x16_q8_0(n, outs[j], 0, vx, ys[j], 1, nc);
+}
