# REFUTED 2026-09-22 00:00. Kept only as the record of a measured negative result.
#
# Hypothesis: mimo2.cpp exports h_nextn before model.output_norm while glm5next, deepseek32, qwen35 and
# qwen3next all export it after, so the MTP head read a mis-scaled hidden state (4-16% acceptance).
# Measured with this patch built into engines/llama.cpp-mimo-tp/build-mtpfix and loaded:
#   trunk parity  IDENTICAL on all 3 golden prompts, max |dlogprob(top1)| 0.0000  (the patch is safe)
#   acceptance    verbatim repeat 0.097 (was 0.159), code 0.164 (was 0.207)  -- NO improvement
#   depth 1/2/3   6.21 / 5.03 / 4.18 tok/s at 0.110 / 0.062 / 0.042 acceptance
# The real answer is that the three model.mtp.layers.* blocks are a TRAINING artifact. MiMo's model card says
# its speculative decoder is the separate 5-layer SWA DFlash drafter in src/dflash. Use SPEC=dflash.
# The shared source tree has been reverted; only build-mtpfix/ still contains this change (default ON there,
# LLAMA_MIMO2_HNEXTN_POSTNORM=0 restores upstream behaviour in that binary).
#
diff --git a/src/models/mimo2.cpp b/src/models/mimo2.cpp
index d50e186..3e64272 100644
--- a/src/models/mimo2.cpp
+++ b/src/models/mimo2.cpp
@@ -1,5 +1,19 @@
 #include "models.h"
 
+// Which hidden state feeds the NextN/MTP draft head: the final norm's output (post-norm) or the last decoder layer's
+// raw residual (pre-norm). Every other NextN architecture in this tree -- glm5next, deepseek32, qwen35, qwen3next --
+// exports it AFTER model.output_norm, and after the MTP block's own head norm for the chained steps. This port
+// exported it before both, which leaves the head reading a state scaled differently from the one it was trained on:
+// measured 8-16% draft acceptance at MTP depth 3 against GLM-5.3-Flash's 77.5%, even on verbatim repetition.
+// Set LLAMA_MIMO2_HNEXTN_POSTNORM=0 to restore the old placement for an A/B without rebuilding.
+static bool mimo2_hnextn_postnorm() {
+    static const bool v = [] {
+        const char * s = getenv("LLAMA_MIMO2_HNEXTN_POSTNORM");
+        return !s || atoi(s) != 0;
+    }();
+    return v;
+}
+
 void llama_model_mimo2::load_arch_hparams(llama_model_loader & ml) {
     ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, hparams.f_norm_rms_eps);
 
@@ -233,7 +247,11 @@ llama_model_mimo2::graph::graph(const llama_model & model, const llm_graph_param
 
     cur = inpL;
 
-    if (emit_h_nextn) {
+    // the norm is per-token, so running it before the out-ids filter is equivalent to running it after -- and it is
+    // what lets the draft head be handed a hidden state for every token in the batch, not just the sampled ones
+    const bool h_nextn_postnorm = mimo2_hnextn_postnorm();
+
+    if (emit_h_nextn && !h_nextn_postnorm) {
         cb(cur, "h_nextn", -1);
         res->t_h_nextn = cur;
 
@@ -246,6 +264,15 @@ llama_model_mimo2::graph::graph(const llama_model & model, const llm_graph_param
             model.output_norm, NULL,
             LLM_NORM_RMS, -1);
 
+    if (emit_h_nextn && h_nextn_postnorm) {
+        cb(cur, "h_nextn", -1);
+        res->t_h_nextn = cur;
+
+        if (!cparams.embeddings_nextn_masked && inp_out_ids) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+        }
+    }
+
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
@@ -378,8 +405,14 @@ llama_model_mimo2::graph_mtp::graph_mtp(const llama_model & model, const llm_gra
 
     cur = ggml_get_rows(ctx0, cur, inp_out_ids);
 
-    cb(cur, "h_nextn", -1);
-    res->t_h_nextn = cur;
+    // the state carried to the NEXT chained draft step must match what the trunk exports, or step 2 and 3 read a
+    // differently scaled hidden state than step 1 did
+    const bool h_nextn_postnorm = mimo2_hnextn_postnorm();
+
+    if (!h_nextn_postnorm) {
+        cb(cur, "h_nextn", -1);
+        res->t_h_nextn = cur;
+    }
 
     ggml_tensor * head_norm_w = layer.nextn.shared_head_norm
             ? layer.nextn.shared_head_norm
@@ -388,6 +421,11 @@ llama_model_mimo2::graph_mtp::graph_mtp(const llama_model & model, const llm_gra
     cur = build_norm(cur, head_norm_w, nullptr, LLM_NORM_RMS, -1);
     cb(cur, "mtp_shared_head_norm", -1);
 
+    if (h_nextn_postnorm) {
+        cb(cur, "h_nextn", -1);
+        res->t_h_nextn = cur;
+    }
+
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
     GGML_ASSERT(head_w && "MIMO2 MTP missing LM head fallback");
