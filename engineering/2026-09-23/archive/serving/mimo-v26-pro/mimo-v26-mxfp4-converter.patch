+    def _write_mxfp4_experts(self):
+        # MIMO_MXFP4_SKELETON=1 reserves every stacked expert tensor as a hole instead of
+        # reading it, so the GGUF can be built with only the non-expert shards on disk.
+        skeleton = os.environ.get("MIMO_MXFP4_SKELETON") == "1"
+        n_expert = self.hparams["n_routed_experts"]
+        n_embd = self.hparams["hidden_size"]
+        n_ff = self.hparams["moe_intermediate_size"]
+        keys = {
+            "gate": gguf.MODEL_TENSOR.FFN_GATE_EXP,
+            "up":   gguf.MODEL_TENSOR.FFN_UP_EXP,
+            "down": gguf.MODEL_TENSOR.FFN_DOWN_EXP,
+        }
+        for bid, is_moe in enumerate(self.hparams["moe_layer_freq"]):
+            if not is_moe:
+                continue
+            for proj, key in keys.items():
+                rows, cols = (n_embd, n_ff) if proj == "down" else (n_ff, n_embd)
+                experts = self._mxfp4_experts.pop((bid, proj), {})
+                sources = None
+                if not skeleton:
+                    missing = [e for e in range(n_expert) if experts.get(e, {}).keys() != {"w", "s"}]
+                    if missing:
+                        raise ValueError(f"layer {bid} {proj}_proj: missing MXFP4 experts {missing[:8]} ({len(missing)} total)")
+                    sources = [(experts[e]["w"], experts[e]["s"]) for e in range(n_expert)]
+                new_name = self.format_tensor_name(key, bid)
