+from .base import LazyTorchTensor, MmprojModel, ModelBase, TextModel, gguf, logger
+
+
+class MXFP4ExpertStack:
+    # A stacked routed-expert tensor in ggml MXFP4 that is produced one expert at a time
+    # when the writer reaches it, so a 1T-parameter model never holds a whole layer in RAM.
+    # With sources=None only the bytes are reserved (a sparse hole): the skeleton pass,
+    # where serving/mimo-v26-pro/fill_experts.py later pwrites every expert in place.
+
+    def __init__(self, n_expert: int, rows: int, cols: int,
+                 sources: list[tuple[Callable[[], Tensor], Callable[[], Tensor]]] | None):
+        assert cols % 32 == 0
+        self.shape = (n_expert, rows, cols // 32 * 17)
+        self.dtype = np.dtype(np.uint8)
+        self.nbytes = n_expert * rows * (cols // 32) * 17
+        self.sources = sources
+
+    def tofile(self, fout) -> None:
+        if self.sources is None:
+            # seek over the tensor, then write its last byte so the hole is part of the file
+            fout.seek(self.nbytes - 1, os.SEEK_CUR)
+            fout.write(b"\0")
+            return
+        for w_gen, s_gen in self.sources:
+            weight = LazyTorchTensor.to_eager(w_gen())
+            scale = LazyTorchTensor.to_eager(s_gen())
+            ModelBase.repack_mxfp4_blocks(weight, scale).tofile(fout)
 
 
