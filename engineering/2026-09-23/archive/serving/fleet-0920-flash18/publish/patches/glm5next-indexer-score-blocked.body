 // ggml_compute_forward_lightning_indexer
 
+#include "li-fast.inc"
+
 void ggml_compute_forward_lightning_indexer(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
 
+    if ((f18_features() & F18_LI_FAST) && f18_li_fast_supported(dst)) {
+        f18_lightning_indexer_fast(params, dst);
+        return;
+    }
