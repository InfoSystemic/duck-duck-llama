# GLM-5.3-Flash f18 stack, revision k (2026-09-20). Revision h plus the composite drafter: n-gram matches first, MTP otherwise.
#   Every byte-reduction idea measured tonight was SLOWER (revision i F16 router 19.7, revision j dense Q6_K 19.8, against h's 20.5):
#   the dense matmuls already run at 71-94 GB/s per socket against a ~95 wall, and a cheaper format costs more in unpacking than it
#   saves in bandwidth. So the remaining lever is tokens per verify cycle (2.45 today), not cycle time.
#   n_max 2 keeps the draft batch the same shape as the MTP path, which the Meta backend requires (one compiled graph per context).
#   n_match 8 is the value that made this composite pay on GLM-5.3 Full (+14% on agentic replay).
#   MEASUREMENT TRAP: ngram-mod keeps its cache ACROSS requests and --no-cache-prompt does not clear it, so re-running the same
#   fixture inflates the rate. Judge it on a prompt the instance has never seen, and report the warm number separately as the
#   agentic-replay case.
# Rollback to revision h: cp ../deploy-0920h/95-f18-0920.conf.proposed over the installed drop-in; daemon-reload; restart.
[Service]
Environment=LIB_PREPEND=/home/user/InfoSystemic/AI-Server/serving/fleet-0920-flash18/deploy-0920k:/home/user/InfoSystemic/AI-Server/serving/fleet-0912-ctx/glm-mtp-kv-only-0919/deploy:/home/user/InfoSystemic/AI-Server/serving/fleet-0912-ctx/glm-kv-range-0919/deploy-r2:/home/user/InfoSystemic/AI-Server/serving/fleet-0912-ctx/glm-kpool-wide-0919/deploy
Environment=GGML_F18_FEATURES=31
Environment=GGML_CPU_GLM_POOL_CACHE=1
Environment=GGML_F18_MTP_MERGE=1
Environment=GGML_F18_MTP_FAST_PICK=1
Environment=GGML_F18_MTP_PAD=1
Environment=GGML_F18_MTP_PAD_MAX_CTX=1048576
Environment=GGML_F18_FAST_SAMPLER=1
Environment=GGML_F18_COUPLED=1
Environment=GOMP_SPINCOUNT=20000
Environment=GGML_CPU_NUMA_SHARED_TEAM=1
Environment=LLAMA_F18_MTP_QROWS=1
Environment=GGML_META_F18=3
# systemd Environment= splits on whitespace unless the whole assignment is quoted; without the quotes each flag became its own
# (invalid) assignment and the server started without EXTRA_ARGS at all.
Environment="EXTRA_ARGS=--spec-type ngram-mod,draft-mtp --spec-ngram-mod-n-max 2 --spec-ngram-mod-n-min 2 --spec-ngram-mod-n-match 8"
