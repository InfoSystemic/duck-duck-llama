+// like select_weight_buft, but only consider each device's default buffer type: extra buffer
+//   types (e.g. CPU weight repacking) may not support the partial writes that slot-wise expert
+//   cache updates require
+// Picks the buffer type that backs one layer's expert cache.
+//
+// The override check has to be repeated here rather than inherited. Streamed experts
+// leave the regular path at llama_model::create_tensor before the loader reaches its own
+// override handling (llama-model-loader.cpp:1160-1186), so without this a --cpu-moe or
+// -ot asking for the experts on the host is accepted on the command line, reported as
+// applied, and then silently ignored for exactly the tensors it names - the cache lands
+// in device memory anyway. The same regex and the same CPU special case are used as on
+// the regular path so that one flag cannot mean two things.
+//
+// This is what makes the cache size a RAM question instead of a VRAM question: on device
+// memory the slot count is capped by what the card has left after the model, and the
+// graph needs 2*cap + n_expert_used slots (llama-graph.cpp:2002), so the reachable batch
+// width is capped with it.
+static ggml_backend_buffer_type_t llama_moe_stream_select_buft(
+        const llama_hparams & hparams, ggml_tensor * meta, const std::string & name,
+        const llama_model_tensor_buft_override * overrides,
+        const buft_list_t * buft_list, const buft_list_t * buft_list_cpu) {
+    if (overrides) {
+        for (const auto * ov = overrides; ov->pattern != nullptr; ++ov) {
+            std::regex pattern(ov->pattern);
+            if (!std::regex_search(name, pattern)) {
+                continue;
+            }
+            // an override to CPU goes through the CPU list so that the extra buffer types
+            // (a host-pinned type, for one) still get their say
+            ggml_backend_buffer_type_t buft = (ov->buft == ggml_backend_cpu_buffer_type())
+                ? select_weight_buft(hparams, meta, GGML_OP_MUL_MAT_ID, buft_list_cpu)
+                : ov->buft;
+            if (buft) {
+                LLAMA_LOG_DEBUG("%s: streamed tensor %s -> %s (override)\n",
+                        __func__, name.c_str(), ggml_backend_buft_name(buft));
+                return buft;
+            }
+            break;
+        }
+    }
+
+    for (const auto & [dev, buft] : *buft_list) {
+        if (buft != ggml_backend_dev_buffer_type(dev)) {
+            continue;
+        }
+        if (weight_buft_supported(hparams, meta, GGML_OP_MUL_MAT_ID, buft, dev)) {
+            return buft;
+        }
+    }
+    return select_weight_buft(hparams, meta, GGML_OP_MUL_MAT_ID, buft_list);
+}
