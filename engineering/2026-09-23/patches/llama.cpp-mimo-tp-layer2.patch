+        // does not. std::max/std::min rather than std::clamp: clamp with lo > hi is undefined, and
+        // lo > hi happens for any model with fewer than 16 experts.
+        n_slots = std::min<uint32_t>(std::max<uint32_t>(n_min, 16), hparams.n_expert);
+        source  = "the default";
+    }
