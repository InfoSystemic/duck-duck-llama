+void ggml_gemv_mxfp4_x16_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+    GGML_ASSERT(nr == 1 && n % QK_MXFP4 == 0 && nc % 16 == 0);
+    GGML_UNUSED(bs);
+    const int nb = n / QK_MXFP4;
+    const block_mxfp4_x16 * vxb = (const block_mxfp4_x16 *) vx; const block_q8_0 * vy8 = (const block_q8_0 *) vy;
+    // nibble -> (kvalues_mxfp4 + 12) as an UNSIGNED byte in [0, 24]: vpdpbusd wants u8 x s8. The +12 bias is
+    // removed exactly per block as 12 * sum(activations). E8M0 scales are pre-halved (kvalues are doubled).
+    alignas(16) uint8_t lut16[16];
+    for (int i = 0; i < 16; i++) lut16[i] = (uint8_t) ((int) kvalues_mxfp4[i] + 12);
+    const __m512i lut = _mm512_broadcast_i32x4(_mm_loadu_si128((const __m128i *) lut16));
+    const __m512i m4  = _mm512_set1_epi8(0x0F);
+    int32_t ysum_stack[512]; float yd_stack[512];
+    int32_t * ysum = ysum_stack; float * yd = yd_stack;
+    std::vector<int32_t> ysum_heap; std::vector<float> yd_heap;
+    if (nb > 512) { ysum_heap.resize(nb); yd_heap.resize(nb); ysum = ysum_heap.data(); yd = yd_heap.data(); }
+    for (int b = 0; b < nb; b++) {
+        const __m256i q = _mm256_loadu_si256((const __m256i *) vy8[b].qs);
+        const __m512i w = _mm512_cvtepi8_epi16(q);
+        const __m256i lo = _mm512_castsi512_si256(w), hi = _mm512_extracti64x4_epi64(w, 1);
+        ysum[b] = _mm512_reduce_add_epi32(_mm512_cvtepi16_epi32(_mm256_add_epi16(lo, hi)));
+        yd[b] = GGML_CPU_FP16_TO_FP32(vy8[b].d);
+    }
+    for (int g = 0; g < nc / 16; g++) { const block_mxfp4_x16 * bp = vxb + (size_t) g * nb; __m512 accf = _mm512_setzero_ps();
+        for (int b = 0; b < nb; b++) {
+            __m512i acc0 = _mm512_setzero_si512(), acc1 = _mm512_setzero_si512();
+            const uint8_t * q0 = bp[b].qs; const int8_t * y0 = vy8[b].qs;
+            for (int i0 = 0; i0 < 4; i0++) {
+                const __m512i w  = _mm512_loadu_si512((const void *)(q0 + i0 * 64));
+                const __m512i lo = _mm512_shuffle_epi8(lut, _mm512_and_si512(w, m4));
+                const __m512i hi = _mm512_shuffle_epi8(lut, _mm512_and_si512(_mm512_srli_epi16(w, 4), m4));
+                acc0 = _mm512_dpbusd_epi32(acc0, lo, GGML_X16_BC32(y0 + 4*i0));
+                acc1 = _mm512_dpbusd_epi32(acc1, hi, GGML_X16_BC32(y0 + 16 + 4*i0));
+            }
+            __m512i acc = _mm512_sub_epi32(_mm512_add_epi32(acc0, acc1), _mm512_set1_epi32(12 * ysum[b]));
+            alignas(64) float sc[16];
+            for (int r = 0; r < 16; r++) sc[r] = GGML_CPU_E8M0_TO_FP32_HALF(bp[b].e[r]);
+            accf = _mm512_fmadd_ps(_mm512_cvtepi32_ps(acc), _mm512_mul_ps(_mm512_load_ps(sc), _mm512_set1_ps(yd[b])), accf);
+        }
+        _mm512_storeu_ps(s + g * 16, accf); }
+    return;
+#endif
+    ggml_gemv_mxfp4_x16_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+}
