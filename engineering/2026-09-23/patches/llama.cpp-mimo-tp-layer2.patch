+    if (n_slots >= hparams.n_expert) {
+        LLAMA_LOG_WARN("%s: MoE expert cache of %u slots covers all %u experts -- streaming disabled, loading normally\n",
+                __func__, n_slots, hparams.n_expert);
+        return true;
+    }
+
+    if (n_slots < n_min) {
+        // An explicit value is never silently raised: it decides the cache footprint, it is what
+        // the command line says, and a later performance figure would otherwise be reported
+        // against a capacity the user did not choose.
+        LLAMA_LOG_ERROR("%s: invalid MoE stream cache capacity: %u slots (from %s), need at least %u "
