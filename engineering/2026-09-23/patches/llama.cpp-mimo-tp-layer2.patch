+// while the wave path needs 18. Measured 2026-08-03, runs/2026-08-03/stream-a1-on/run-01.raw.txt:
+// "have 16, need 18".
+static bool llama_moe_stream_resolve_slots(const llama_model_params & params, const llama_hparams & hparams, const llama_model_loader & ml, uint32_t & n_slots_out) {
+    n_slots_out = 0;
