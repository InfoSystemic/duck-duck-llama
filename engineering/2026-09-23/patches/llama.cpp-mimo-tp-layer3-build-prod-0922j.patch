+static void ggml_compute_forward_flash_attn_ext_gqa(
+        const ggml_compute_params * params,
+        ggml_tensor * dst,
+        const fa_gqa_plan & p) {
+#if defined(GGML_SIMD) && !defined(__ARM_FEATURE_SVE) && !defined(__riscv_v_intrinsic)
+    const ggml_tensor * q     = dst->src[0];
+    const ggml_tensor * k     = dst->src[1];
+    const ggml_tensor * v     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    const int64_t DK        = k->ne[0];
+    const int64_t DV        = v->ne[0];
+    const int64_t N         = q->ne[1];
+    const int64_t n_head    = q->ne[2];
+    const int64_t n_head_kv = k->ne[2];
+    const int64_t T         = FA_GQA_T;
+    const int64_t rk2       = n_head / n_head_kv;
+    const int64_t Gp        = rk2 * p.NR;   // partial slots per item
+
+    float scale = 1.0f;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t pstride = 2 + DV;   // per query: M, S, O[DV]
+    GGML_ASSERT(params->wsize >= sizeof(float) * (nth * fa_gqa_thread_floats(DK, DV) + p.n_items * Gp * pstride));
+
+    float * wbase    = (float *) params->wdata + ith * fa_gqa_thread_floats(DK, DV);
+    float * Qf       = wbase;                       // [G x DK]  scaled queries, g = row*rk2 + head
+    float * O        = Qf + FA_GQA_G_MAX*DK;        // [G x DV]  output accumulators
+    float * Sc       = O  + FA_GQA_G_MAX*DV;        // [G x T]   scores, then probabilities
+    float * KT       = Sc + FA_GQA_G_MAX*T;         // [DK x T]  K tile, transposed
+    float * Vt       = KT + DK*T;                   // [T x DV]  V tile
+    float * Mx       = Vt + T*DV;                   // [G]       running max
+    float * Sm       = Mx + FA_GQA_G_MAX;           // [G]       running sum
+    float * Mk       = Sm + FA_GQA_G_MAX;           // [NR x T]  mask tile
+    float * partials = (float *) params->wdata + nth * fa_gqa_thread_floats(DK, DV);
+
+    if (ith == 0) {
+        ggml_threadpool_chunk_set(params->threadpool, nth);
+    }
+    ggml_barrier(params->threadpool);
+
+    for (int64_t item = ith; item < p.n_items; item = ggml_threadpool_chunk_add(params->threadpool, 1)) {
+        const int64_t ch  = item % p.n_chunks;
+        const int64_t ik2 = (item / p.n_chunks) % n_head_kv;
+        const int64_t rg  = item / (p.n_chunks * n_head_kv);
+        const int64_t r0  = rg * p.NR;
+        const int64_t nr  = std::min(p.NR, N - r0);
+        const int64_t G   = rk2 * nr;
+        const int64_t ic0 = p.lo + ch * p.chunk;
+        const int64_t ic1 = std::min(ic0 + p.chunk, p.hi);
+
+        bool started = false;
+        for (int64_t ic = ic0; ic < ic1; ic += T) {
+            const int64_t t = std::min(T, ic1 - ic);
+
+            // mask tile; a tile no row can see is skipped outright
+            bool all_zero = true;
+            if (mask) {
+                bool any = false;
+                for (int64_t rr = 0; rr < nr; rr++) {
+                    const ggml_fp16_t * mp = (const ggml_fp16_t *) ((const char *) mask->data + (r0 + rr)*mask->nb[1]) + ic;
+                    float * mrow = Mk + rr*T;
+                    for (int64_t tk = 0; tk < t; tk++) {
+                        const float m = GGML_CPU_FP16_TO_FP32(mp[tk]);
+                        mrow[tk]  = m;
+                        any      |= m != -INFINITY;
+                        all_zero &= m == 0.0f;
+                    }
+                }
+                if (!any) {
+                    continue;
+                }
+            }
+
+            if (!started) {
+                started = true;
+                for (int64_t rr = 0; rr < nr; rr++) {
+                    for (int64_t j = 0; j < rk2; j++) {
+                        const float * pq = (const float *) ((const char *) q->data + (r0 + rr)*q->nb[1] + (ik2*rk2 + j)*q->nb[2]);
+                        float * dq = Qf + (rr*rk2 + j)*DK;
+                        for (int64_t d = 0; d < DK; d++) {
+                            dq[d] = pq[d] * scale;
+                        }
+                    }
+                }
+                for (int64_t g = 0; g < G; g++) {
+                    Mx[g] = -INFINITY;
+                    Sm[g] = 0.0f;
+                }
+                memset(O, 0, G*DV*sizeof(float));
+            }
+
+            // K tile transposed to [DK x T] (the score GEMM runs along the KV axis), zero-padded
+#if defined(__AVX512F__)
+            if (k->type == GGML_TYPE_F16 && DK % 16 == 0 && T % 16 == 0) {
+                // 16 keys x 16 dims at a time: vector F16->F32 conversion, in-register transpose, 16 row stores.
+                // Same floats as the scalar path (the conversion is exact), at ~1/8 of the instructions.
+                for (int64_t tb = 0; tb < T; tb += 16) {
+                    for (int64_t db = 0; db < DK; db += 16) {
+                        __m512 r[16];
+                        for (int i = 0; i < 16; i++) {
+                            if (tb + i < t) {
+                                const ggml_fp16_t * k16 = (const ggml_fp16_t *) ((const char *) k->data + (ic + tb + i)*k->nb[1] + ik2*k->nb[2]) + db;
+                                r[i] = _mm512_cvtph_ps(_mm256_loadu_si256((const __m256i *) k16));
+                            } else {
+                                r[i] = _mm512_setzero_ps();
+                            }
+                        }
+                        fa_gqa_transpose16(r);
+                        for (int i = 0; i < 16; i++) {
+                            _mm512_storeu_ps(KT + (db + i)*T + tb, r[i]);
+                        }
+                    }
+                }
+            } else
+#endif
+            {
+            if (t < T) {
+                memset(KT, 0, DK*T*sizeof(float));
+            }
+            for (int64_t tk = 0; tk < t; tk++) {
+                const char * kp = (const char *) k->data + (ic + tk)*k->nb[1] + ik2*k->nb[2];
+                if (k->type == GGML_TYPE_F16) {
+                    const ggml_fp16_t * k16 = (const ggml_fp16_t *) kp;
+                    for (int64_t d = 0; d < DK; d++) {
+                        KT[d*T + tk] = GGML_CPU_FP16_TO_FP32(k16[d]);
+                    }
+                } else {
+                    const float * k32 = (const float *) kp;
+                    for (int64_t d = 0; d < DK; d++) {
+                        KT[d*T + tk] = k32[d];
+                    }
+                }
+            }
+            }
+
+            memset(Sc, 0, G*T*sizeof(float));
+            fa_gqa_gemm(Sc, Qf, KT, (int) G, (int) DK, (int) T);
+
+            for (int64_t g = 0; g < G; g++) {
+                float * srow = Sc + g*T;
+                if (mask && !all_zero) {
+                    const float * mrow = Mk + (g / rk2)*T;
+                    for (int64_t tk = 0; tk < t; tk++) {
+                        srow[tk] += mrow[tk];
+                    }
+                }
+                for (int64_t tk = t; tk < T; tk++) {
+                    srow[tk] = -INFINITY;
+                }
+            }
+
+            // online softmax, one query at a time
+            for (int64_t g = 0; g < G; g++) {
+                float * srow = Sc + g*T;
+                float tmax = -INFINITY;
+#if defined(__AVX512F__)
+                // ggml_vec_max_f32 is a scalar loop (a float max reduction does not vectorize without fast-math): a
+                // 64-step dependent vmaxss chain per query row was ~2/3 of the softmax phase. max is exact in any order
+                // (only the sign of a zero maximum could differ, and x - (+-0) feeds identical exps), so bit-identical.
+                if (T % 16 == 0) {
+                    __m512 vm = _mm512_loadu_ps(srow);
+                    for (int64_t tk = 16; tk < T; tk += 16) {
+                        vm = _mm512_max_ps(vm, _mm512_loadu_ps(srow + tk));
+                    }
+                    tmax = _mm512_reduce_max_ps(vm);
+                } else
+#endif
+                ggml_vec_max_f32((int) T, &tmax, srow);
+                if (tmax == -INFINITY) {
+                    memset(srow, 0, T*sizeof(float));
+                    continue;
+                }
+                if (tmax > Mx[g]) {
+                    const float ms = expf(Mx[g] - tmax);   // 0 on the first visible tile
+                    ggml_vec_scale_f32((int) DV, O + g*DV, ms);
+                    Sm[g] *= ms;
+                    Mx[g]  = tmax;
+                }
+                Sm[g] += (float) ggml_vec_soft_max_f32((int) T, srow, srow, Mx[g]);
+            }
+
+            // V tile [T x DV], zero-padded
+            for (int64_t tk = 0; tk < t; tk++) {
+                const char * vp = (const char *) v->data + (ic + tk)*v->nb[1] + ik2*v->nb[2];
+                if (v->type == GGML_TYPE_F16) {
+                    ggml_cpu_fp16_to_fp32((const ggml_fp16_t *) vp, Vt + tk*DV, DV);
+                } else {
+                    memcpy(Vt + tk*DV, vp, DV*sizeof(float));
+                }
+            }
+            if (t < T) {
+                memset(Vt + t*DV, 0, (T - t)*DV*sizeof(float));
+            }
+
+            fa_gqa_gemm(O, Sc, Vt, (int) G, (int) T, (int) DV);
+        }
+
+        float * part = partials + item*Gp*pstride;
+        for (int64_t g = 0; g < G; g++) {
+            float * pg = part + g*pstride;
+            if (!started) {
+                pg[0] = -INFINITY;
+                pg[1] = 0.0f;   // the merge skips empty partials without reading O
+                continue;
+            }
+            pg[0] = Mx[g];
+            pg[1] = Sm[g];
+            memcpy(pg + 2, O + g*DV, DV*sizeof(float));
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // merge the chunks of each output (row, head); the thread's scratch is free again
+    float * acc = wbase;
+    for (int64_t idx = ith; idx < N*n_head; idx += nth) {
+        const int64_t r   = idx / n_head;
+        const int64_t h   = idx % n_head;
+        const int64_t ik2 = h / rk2;
+        const int64_t rg  = r / p.NR;
+        const int64_t g   = (r % p.NR)*rk2 + (h % rk2);
+
+        float M = -INFINITY;
+        float S = 0.0f;
+        memset(acc, 0, DV*sizeof(float));
+        for (int64_t ch = 0; ch < p.n_chunks; ch++) {
+            const float * pg = partials + ((rg*n_head_kv + ik2)*p.n_chunks + ch)*Gp*pstride + g*pstride;
+            if (pg[1] == 0.0f) {
+                continue;
+            }
+            const float Mn = std::max(M, pg[0]);
+            const float so = expf(M - Mn);
+            const float sn = expf(pg[0] - Mn);
+            for (int64_t d = 0; d < DV; d++) {
+                acc[d] = acc[d]*so + pg[2 + d]*sn;
+            }
+            S = S*so + pg[1]*sn;
+            M = Mn;
+        }
+        if (sinks) {
+            const float s  = ((const float *) sinks->data)[h];
+            const float Mn = std::max(M, s);
+            const float so = expf(M - Mn);
+            ggml_vec_scale_f32((int) DV, acc, so);
+            S = S*so + expf(s - Mn);
+        }
+        const float S_inv = S == 0.0f ? 0.0f : 1.0f/S;
+        float * out = (float *) ((char *) dst->data + (r*dst->ne[1] + h)*dst->nb[1]);
+        for (int64_t d = 0; d < DV; d++) {
+            out[d] = acc[d]*S_inv;
+        }
+    }
+#else
+    GGML_UNUSED(params); GGML_UNUSED(dst); GGML_UNUSED(p);
+    GGML_ABORT("fa_gqa: built without SIMD");
+#endif
+}
