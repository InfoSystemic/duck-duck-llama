+// up to 12 columns per call; calls wider than 8 run one 16-row group at a time (see above)
+template <typename W, template <int> class KK>
+static void ggml_x16_gemm_dispatch(int n, int blck, int32_t mult, int nr, float * const * outs, const void * const * ys, const void * vx, int nc,
+                                   const int32_t * const * ybias, const float * const * yds) {
+    const int nb = n / blck;
+    const block_q8_0 * y[16];
+    const int32_t * ybp[16];
+    const float * ydp[16];
+    int32_t ybias_stack[12 * 512]; float yd_stack[12 * 512];
+    std::vector<int32_t> ybias_heap; std::vector<float> yd_heap;
+    for (int j = 0; j < nr; j++) {
+        y[j] = (const block_q8_0 *) ys[j];
+    }
+    if (ybias != nullptr && yds != nullptr) {
+        for (int j = 0; j < nr; j++) { ybp[j] = ybias[j]; ydp[j] = yds[j]; }
+    } else {
+        int32_t * yb = ybias_stack; float * yd = yd_stack;
+        if (nb > 512) { ybias_heap.resize((size_t) 12 * nb); yd_heap.resize((size_t) 12 * nb); yb = ybias_heap.data(); yd = yd_heap.data(); }
+        for (int j = 0; j < nr; j++) {
+            ggml_x16_col_prep(y[j], nb, mult, yb + j*nb, yd + j*nb);
+            ybp[j] = yb + j*nb; ydp[j] = yd + j*nb;
+        }
+    }
+    const W * w = (const W *) vx;
+    switch (nr) {
+        case 1:  KK<1>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 2:  KK<2>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 3:  KK<3>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 4:  KK<4>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 5:  KK<5>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 6:  KK<6>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 7:  KK<7>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 8:  KK<8>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 9:  KK<9>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 10: KK<10>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        case 11: KK<11>::run(nb, outs, y, w, nc, ybp, ydp); break;
+        default: KK<12>::run(nb, outs, y, w, nc, ybp, ydp); break;
+    }
+}
+template <int NR> struct ggml_x16_q8_0_k  { static void run(int nb, float * const * o, const block_q8_0 * const * y, const block_q8_0_x16 * w, int nc, const int32_t * const * s, const float * const * d) { ggml_x16_gemm_q8_0_nr<NR>(nb, o, y, w, nc, s, d); } };
+template <int NR> struct ggml_x16_mxfp4_k { static void run(int nb, float * const * o, const block_q8_0 * const * y, const block_mxfp4_x16 * w, int nc, const int32_t * const * s, const float * const * d) { ggml_x16_gemm_mxfp4_nr<NR>(nb, o, y, w, nc, s, d); } };
+#endif
+
+void ggml_x16_q8_0_col_prep_bias(const void * y, int nb, int32_t mult, int32_t * ybias, float * yd) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+    ggml_x16_col_prep((const block_q8_0 *) y, nb, mult, ybias, yd);
+#else
+    const block_q8_0 * yb = (const block_q8_0 *) y;
+    for (int b = 0; b < nb; b++) {
+        int32_t sum = 0;
+        for (int i = 0; i < QK8_0; i++) sum += yb[b].qs[i];
+        ybias[b] = -mult * sum;
+        yd[b] = GGML_CPU_FP16_TO_FP32(yb[b].d);
+    }
+#endif
+}
+
+void ggml_gemm_ptrs_q8_0_x16_q8_0(int n, int nr, float * const * outs, const void * const * ys, const void * vx, int nc,
+                                  const int32_t * const * ybias, const float * const * yds) {
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
