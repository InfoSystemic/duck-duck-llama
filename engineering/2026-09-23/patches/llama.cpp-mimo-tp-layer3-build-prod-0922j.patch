+
+// ---- multi-column x16 kernels for prompt batches ----------------------------------------------------------------
+// Up to 12 activation rows per call, passed as pointer arrays because MoE token rows are not contiguous. Every weight
+// vector that is loaded -- and for MXFP4, LUT-decoded -- is reused for all of them, where the GEMV above reloads it
+// once per activation row; that is what held prompt processing near L2 bandwidth (~13% of VNNI peak). For each
+// (row, column) the float operations are exactly the GEMV's, in the same order, and the integer dot products are
+// exact in any order, so the output is bit-identical to calling the GEMV once per column.
+//
+// Two 16-row groups per pass (calls of <= 8 columns): each activation dword is broadcast ONCE into a register and feeds
+// two register-form vpdpbusd. The {1to16} memory form issues at ~1/cycle on this core (Cascade Lake) where the register
+// form reaches ~1.85, and it spent a load per dot product; the accumulators also start at the bias correction
+// (ybias = -mult * block sum, precomputed per matmul) instead of zero + vpsubd. Single-core, same data, interleaved:
+// Q8_0 41.7 -> 29.2 ms (1.43x), MXFP4 36.3 -> 31.0 ms (1.19x), and faster at decode widths 1-8 too. Bit-identical.
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__)
+// vpdpbusd with the activation dword broadcast straight from memory ({1to16}): the single-group path, where each
+// broadcast feeds one dot product. GCC otherwise emits a separate vpbroadcastd per dpbusd.
+static inline __m512i ggml_x16_dpbusd_m32(__m512i acc, __m512i w, const void * p) {
+    __asm__("vpdpbusd %2%{1to16%}, %1, %0" : "+v"(acc) : "v"(w), "m"(*(const int32_t *) p));
+    return acc;
+}
+// per-block bias (-mult * sum of the 32 activation bytes; mult = the weights' unsigned offset, Q8_0 128, MXFP4 12) and
+// scale of one Q8_0 activation row, exactly as the x16 GEMV derives them
+static inline void ggml_x16_col_prep(const block_q8_0 * y, int nb, int32_t mult, int32_t * ybias, float * yd) {
+    for (int b = 0; b < nb; b++) {
+        const __m256i q = _mm256_loadu_si256((const __m256i *) y[b].qs);
+        const __m512i w = _mm512_cvtepi8_epi16(q);
+        const __m256i lo = _mm512_castsi512_si256(w), hi = _mm512_extracti64x4_epi64(w, 1);
+        ybias[b] = -mult * _mm512_reduce_add_epi32(_mm512_cvtepi16_epi32(_mm256_add_epi16(lo, hi)));
+        yd[b] = GGML_CPU_FP16_TO_FP32(y[b].d);
+    }
+}
