+        return fallback;
+    }
+    char * end = nullptr;
+    const long parsed = strtol(value, &end, 10);
+    if (end == nullptr || *end != '\0' || parsed <= 0 || parsed > INT_MAX) {
+        GGML_LOG_WARN("%s: ignoring invalid %s=%s\n", __func__, name, value);
