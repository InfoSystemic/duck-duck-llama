+def test_request_draft_max_is_bounded_by_server():
+    global server
+    server.spec_draft_n_min = 0
+    server.spec_draft_n_max = 8
+    server.start()
+
+    request = {
+        "prompt": "I believe the meaning of life is",
+        "temperature": 0.0,
+        "top_k": 1,
+        "seed": 4242,
+        "n_predict": 32,
+        "return_tokens": True,
+    }
+
+    no_draft = server.make_request("POST", "/completion", data={
+        **request,
+        "speculative.n_max": 0,
+    })
+    assert no_draft.status_code == 200
+    assert no_draft.body["timings"].get("draft_n", 0) == 0
+
+    one_draft = server.make_request("POST", "/completion", data={
+        **request,
+        "speculative": {"n_max": 1},
+    })
+    assert one_draft.status_code == 200
+    assert one_draft.body["timings"]["draft_n"] > 0
+    assert no_draft.body["tokens"] == one_draft.body["tokens"]
+
+    too_large = server.make_request("POST", "/completion", data={
+        **request,
+        "speculative.n_max": 9,
+    })
+    assert too_large.status_code == 400
+    assert "speculative.n_max" in too_large.body["error"]["message"]
+
+
+def test_request_draft_default_below_server_cap_and_precedence():
+    global server
+    server.spec_draft_n_min = 0
+    server.spec_draft_n_max = 8
+    server.spec_draft_n_default = 2
+    server.start()
+
+    request = {
+        "model": server.model_alias,
+        "messages": [{"role": "user", "content": "I believe the meaning of life is"}],
+        "temperature": 0.0,
+        "max_tokens": 2,
+        "verbose": True,
+    }
+
+    defaulted = server.make_request("POST", "/v1/chat/completions", data=request)
+    assert defaulted.status_code == 200
+    assert defaulted.body["__verbose"]["generation_settings"]["speculative.n_max"] == 2
+
+    dotted = server.make_request("POST", "/v1/chat/completions", data={
+        **request,
+        "speculative.n_max": 7,
+    })
+    assert dotted.status_code == 200
+    assert dotted.body["__verbose"]["generation_settings"]["speculative.n_max"] == 7
+
+    nested = server.make_request("POST", "/v1/chat/completions", data={
+        **request,
+        "speculative": {"n_max": 6},
+    })
+    assert nested.status_code == 200
+    assert nested.body["__verbose"]["generation_settings"]["speculative.n_max"] == 6
+
+
+def test_request_draft_p_min_is_bounded_probability():
+    global server
+    server.start()
+
+    request = {
+        "prompt": "I believe the meaning of life is",
+        "temperature": 0.0,
+        "top_k": 1,
+        "seed": 4242,
+        "n_predict": 16,
+        "return_tokens": True,
+    }
+
+    results = []
+    for i, p_min in enumerate((0.0, 0.5, 1.0)):
+        res = server.make_request("POST", "/completion", data={
+            **request,
+            **({"speculative.p_min": p_min} if i == 0 else {"speculative": {"p_min": p_min}}),
+        })
+        assert res.status_code == 200
+        results.append(res.body)
+
+    assert results[0]["timings"]["draft_n"] > 0
+    assert results[2]["timings"].get("draft_n", 0) == 0
+    assert results[0]["tokens"] == results[2]["tokens"]
+
+    for p_min in (-0.01, 1.01):
+        res = server.make_request("POST", "/completion", data={
+            **request,
+            "speculative.p_min": p_min,
+        })
+        assert res.status_code == 400
+        assert "speculative.p_min" in res.body["error"]["message"]
+
+
