 using json = nlohmann::ordered_json;
 
+static bool responses_is_custom_tool(
+        const std::unordered_set<std::string> & custom_tools,
+        const std::string & name) {
+    return custom_tools.find(name) != custom_tools.end();
+}
+
+static std::string responses_custom_tool_input(const std::string & arguments) {
+    try {
+        const json parsed = json::parse(arguments);
+        if (parsed.is_object() && parsed.contains("input") && parsed.at("input").is_string()) {
+            return parsed.at("input").get<std::string>();
+        }
+        if (parsed.is_string()) {
+            return parsed.get<std::string>();
+        }
+    } catch (const std::exception &) {
+        // Preserve malformed or already-freeform arguments for client-side
+        // validation instead of dropping a potentially recoverable tool call.
+    }
+    return arguments;
+}
+
+static std::string responses_tool_item_id(
+        const std::unordered_set<std::string> & custom_tools,
+        const std::string & name,
+        const std::string & id) {
+    return (responses_is_custom_tool(custom_tools, name) ? "ctc_" : "fc_") + id;
+}
+
+static json responses_tool_call_item(
+        const common_chat_tool_call & tool_call,
+        const std::unordered_set<std::string> & custom_tools,
+        const std::string & status) {
+    const bool is_custom = responses_is_custom_tool(custom_tools, tool_call.name);
+    json item = {
+        {"id",      responses_tool_item_id(custom_tools, tool_call.name, tool_call.id)},
+        {"type",    is_custom ? "custom_tool_call" : "function_call"},
+        {"status",  status},
+        {"call_id", "call_" + tool_call.id},
+        {"name",    tool_call.name},
+    };
+    if (is_custom) {
+        item["input"] = responses_custom_tool_input(tool_call.arguments);
+    } else {
+        item["arguments"] = tool_call.arguments;
+    }
+    return item;
+}
+
 //
 // task_params
 //
@@ -81,6 +130,8 @@ json task_params::to_json(bool only_metrics) const {
             {"generation_prompt",         chat_parser_params.generation_prompt},
             {"samplers",                  samplers},
