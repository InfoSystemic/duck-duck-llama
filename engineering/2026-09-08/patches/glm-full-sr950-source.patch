+                        const uint32_t packed =
+                            (packed_scales >> (16 * row_group)) & 0xffff;
+                        const uint32_t expanded =
+                            (packed & 0x000f) |
+                            ((packed & 0x00f0) << 4) |
+                            ((packed & 0x0f00) << 8) |
+                            ((packed & 0xf000) << 12);
