+        int last  = 0;
+        try {
+            first = std::stoi(token.substr(0, dash));
+            last  = dash == std::string::npos ? first : std::stoi(token.substr(dash + 1));
+        } catch (const std::exception &) {
+            return {};
+        }
+        if (first < 0 || last < first) {
