+        GGML_UNUSED(n_threads);
+        if (op->op == GGML_OP_MUL_MAT) {
+            size = (size_t) ggml_nelements(op->src[1]) * sizeof(ggml_fp16_t);
+            return true;
+        }
+        return false;
