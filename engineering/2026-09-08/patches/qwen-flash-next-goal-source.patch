+    // phase 1: every device has produced its partial(s)
+    if (ith == 0) {
+        d->arrive1.fetch_add(1, std::memory_order_acq_rel);
+    }
+    ggml_backend_meta_fused_spin_until(d->arrive1, n, "arrive1");
