+        float * p[GGML_META_FUSED_MAX_DEVS];
+        for (int jj = 0; jj < n; jj++) {
+            p[jj] = (float *) d->nodes[r][jj]->data;
+        }
+        bool all_active = true;
+        for (int jj = 0; jj < n; jj++) {
