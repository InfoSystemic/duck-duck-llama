+// Four codes per output channel let each VNNI lane produce one row sum.
+struct block_iq_r16 {
+    ggml_half d[16];
+    uint8_t scales[(QK_K / 32) * 16];
+    uint8_t qs[(QK_K / 16) * 4 * 32];
+};
+static_assert(sizeof(block_iq_r16) == 2208, "wrong block_iq_r16 size/padding");
