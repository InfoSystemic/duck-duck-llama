+// Reduce routed expert outputs after applying their router weights. The
+// unfused graph materializes a weighted [n_embd, n_expert_used, n_tokens]
+// tensor and then serializes n_expert_used - 1 ADD nodes. Computing the same
+// expert-ordered sum directly removes those intermediate writes and barriers.
+static void ggml_compute_forward_moe_weighted_sum_fused(
+        const struct ggml_compute_params * params,
+        const struct ggml_tensor * mul,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * experts = mul->src[0];
+    const struct ggml_tensor * weights = mul->src[1];
+
+    GGML_ASSERT(experts->type == GGML_TYPE_F32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(mul->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
