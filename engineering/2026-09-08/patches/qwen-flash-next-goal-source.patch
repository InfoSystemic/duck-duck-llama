+        for (int b = 0; b < nb; b++) {
+            __m512i acc = _mm512_setzero_si512();
+            const uint8_t * q0 = bp[b].qs; const int8_t * y0 = vy8[b].qs;
+            for (int i0 = 0; i0 < 8; i0++) acc = _mm512_dpbusd_epi32(acc, _mm512_loadu_si512((const void *)(q0 + i0 * 64)), GGML_X16_BC32(y0 + 4*i0));
