+static void ggml_backend_meta_fused_reduce_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(dst);
+    auto * ud = (ggml_backend_meta_fused_reduce_userdata *) userdata;
+    ggml_backend_meta_fused_reduce_desc * d = ud->desc;
+    const int j = ud->dev;
+    const int n = d->n_devs;
+    int64_t ne_max = 0;
+    for (int r = 0; r < d->n_red; r++) {
+        ne_max = std::max<int64_t>(ne_max, ggml_nelements(d->nodes[r][j]));
+    }
+    const int nth_reduce = d->single_task_max_elements > 0 && ne_max <= d->single_task_max_elements ? 1 : nth;
+
+    // Small reductions move too little data to justify waking every worker on every NUMA
+    // device.  The inactive workers meet the graph's normal post-node barrier while worker
+    // zero performs the cross-device synchronization and reduction.
+    if (ith >= nth_reduce) {
+        return;
+    }
