+    for (int r = 0; r < d->n_red; r++) {
+        const int64_t ne = ggml_nelements(d->nodes[r][j]);
+        const int64_t per_dev = (ne + n - 1) / n;
+        const int64_t d_start = std::min<int64_t>(ne, (int64_t) j * per_dev);
+        const int64_t d_end   = std::min<int64_t>(ne, d_start + per_dev);
+        const int64_t per_thr = (d_end - d_start + nth_reduce - 1) / nth_reduce;
+        const int64_t t_start = std::min<int64_t>(d_end, d_start + (int64_t) ith * per_thr);
+        const int64_t t_end   = std::min<int64_t>(d_end, t_start + per_thr);
