+static void qK_r8_get_scale_min(
+        int j, const uint8_t * GGML_RESTRICT packed,
+        uint8_t * GGML_RESTRICT scale, uint8_t * GGML_RESTRICT min) {
+    if (j < 4) {
+        *scale = packed[j] & 63;
+        *min = packed[j + 4] & 63;
+    } else {
+        *scale = (packed[j + 4] & 0x0f) | ((packed[j - 4] >> 6) << 4);
+        *min = (packed[j + 4] >> 4) | ((packed[j] >> 6) << 4);
+    }
+}
