+// Compute sibling dense gate/up projections and their SwiGLU output in one
+// pass. The two weights remain independent tensors, while activation
+// quantization, work distribution, and graph synchronization are shared.
+static void ggml_compute_forward_mul_mat_swiglu_one_chunk(
+        struct ggml_tensor * dst,
+        const struct ggml_tensor * gate,
+        const struct ggml_tensor * up,
+        const int64_t ir0_start,
+        const int64_t ir0_end,
+        const int64_t ir1_start,
+        const int64_t ir1_end,
+        const void * wdata) {
+
+    const struct ggml_tensor * src0 = gate->src[0];
+    const struct ggml_tensor * src0_up = up->src[0];
+    const struct ggml_tensor * src1 = gate->src[1];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const enum ggml_type type = src0->type;
+    const ggml_vec_dot_t vec_dot = type_traits_cpu[type].vec_dot;
+    const enum ggml_type vec_dot_type = type_traits_cpu[type].vec_dot_type;
+    const bool src1_cont = ggml_is_contiguous(src1);
+    const size_t row_size = ggml_row_size(vec_dot_type, ne10);
+    const size_t src1_col_stride = src1_cont || src1->type != vec_dot_type ? row_size : nb11;
+    const int64_t r2 = ne12 / ne02;
+    const int64_t r3 = ne13 / ne03;
+
+    if (ir0_start >= ir0_end || ir1_start >= ir1_end) {
+        return;
+    }
+
+    const int64_t blck_0 = 16;
+    const int64_t blck_1 = 16;
+    float gate_tmp[16];
+    float up_tmp[16];
+    float out_tmp[16];
+
+    for (int64_t iir1 = ir1_start; iir1 < ir1_end; iir1 += blck_1) {
+        for (int64_t iir0 = ir0_start; iir0 < ir0_end; iir0 += blck_0) {
+            for (int64_t ir1 = iir1; ir1 < iir1 + blck_1 && ir1 < ir1_end; ++ir1) {
+                const int64_t i13 = ir1 / (ne12*ne1);
+                const int64_t i12 = (ir1 - i13*ne12*ne1) / ne1;
+                const int64_t i11 = ir1 - i13*ne12*ne1 - i12*ne1;
+                const int64_t i03 = i13 / r3;
+                const int64_t i02 = i12 / r2;
+
+                const char * src0_gate_row = (const char *) src0->data + i02*nb02 + i03*nb03;
+                const char * src0_up_row = (const char *) src0_up->data +
+                    i02*src0_up->nb[2] + i03*src0_up->nb[3];
+                const char * src1_col = (const char *) wdata +
+                    (src1_cont || src1->type != vec_dot_type
+                        ? (i11 + i12*ne11 + i13*ne12*ne11)*row_size
+                        : i11*nb11 + i12*nb12 + i13*nb13);
+                float * dst_col = (float *) ((char *) dst->data + i11*nb1 + i12*nb2 + i13*nb3);
+
+                const int64_t ir0_stop = MIN(iir0 + blck_0, ir0_end);
+                for (int64_t ir0 = iir0; ir0 < ir0_stop; ++ir0) {
+                    vec_dot(ne00, &gate_tmp[ir0 - iir0], 0,
+                        src0_gate_row + ir0*nb01, 0, src1_col, src1_col_stride, 1);
+                }
+                for (int64_t ir0 = iir0; ir0 < ir0_stop; ++ir0) {
+                    vec_dot(ne00, &up_tmp[ir0 - iir0], 0,
+                        src0_up_row + ir0*src0_up->nb[1], 0, src1_col, src1_col_stride, 1);
+                }
+
+                const int64_t n = ir0_stop - iir0;
+                ggml_vec_swiglu_f32(n, out_tmp, gate_tmp, up_tmp);
+                memcpy(&dst_col[iir0], out_tmp, n*sizeof(float));
+            }
+        }
+    }
+}
