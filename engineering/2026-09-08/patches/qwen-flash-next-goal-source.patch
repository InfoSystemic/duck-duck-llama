+            float * GGML_RESTRICT p2 = p[2];
+            float * GGML_RESTRICT p3 = p[3];
+            for (int64_t k = t_start; k < t_end; ++k) {
+                const float sum = (p0[k] + p1[k]) + (p2[k] + p3[k]);
+                p0[k] = sum;
+                p1[k] = sum;
+                p2[k] = sum;
+                p3[k] = sum;
+            }
