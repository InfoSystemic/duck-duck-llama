# GLM-5.3 (non-Flash) SR950 production config.
#
# Derived from the proven GLM-5.2 `model.env` production profile, repointed at
# the GLM-5.3 UD-Q3_K_XL shard set and adjusted for one hard constraint:
# GLM-5.3 currently lives in tmpfs (/dev/shm, 319.4 GiB, unreclaimable), and
# numa-tensor allocates a SECOND node-bound copy of the weights. Budget:
#
#   tmpfs 319.4 + node-bound 319.4 + Qwen mlock 39.6 + KV/act/OS ~35 = ~714 GiB
#
# of 755 GiB. Enabling the compact repacks would raise the node-bound copy to
# 381.8 GiB (preflight `projected_weight_bytes`) and overrun the box, so the
# repack gates stay off until the model is moved off tmpfs onto disk.
GLM_BINARY=/home/user/InfoSystemic/AI-Server/engines/llama.cpp-sr950-glm/build-sr950-glm-pgo-q5-r8-20260826/bin/llama-server
GLM_MODEL=/dev/shm/ai-models/GLM-5.3-GGUF/UD-Q3_K_XL/GLM-5.3-UD-Q3_K_XL-00001-of-00009.gguf
GLM_HOST=127.0.0.1
GLM_PORT=18091
GLM_CONTEXT_SIZE=32768
GLM_PARALLEL=1
GLM_BATCH_SIZE=512
GLM_UBATCH_SIZE=256
GLM_THREADS=16
GLM_CACHE_TYPE_K=q8_0
GLM_CACHE_TYPE_V=q8_0
GLM_ALIASES=glm-sr950,glm-sr950-agentic,glm-5.3-sr950,glm-5.3,glm53,GLM-5.3
GLM_BACKEND_MODE=numa-tensor
GLM_LOG_VERBOSITY=2
GLM_CHAT_TEMPLATE_FILE=/home/user/InfoSystemic/AI-Server/serving/glm-sr950/chat-template-glm-5.3-llamacpp.jinja
GLM_REASONING_PRESERVE=1

# No speculation yet. The checked-in MTP draft is GLM-5.2's and must never be
# paired with a 5.3 target; a 5.3 MTP has to be extracted first.
GLM_SPEC_TYPE=none
GLM_MTP_MODEL=
GLM_SPEC_ALIAS_P_MIN=

# Four-socket tensor-parallel backend. These are the gates the 5.2 production
# profile ran; DEVICES/ATTN_TP/DIRECT_ALLREDUCE are exactly what the staged
# bring-up had switched off.
GGML_CPU_NUMA_DEVICES=1
GGML_CPU_NUMA_THREADS=16
GGML_CPU_NUMA_POLL=50
GGML_CPU_NUMA_HUGEPAGES=1
GGML_CPU_NUMA_DIRECT_ALLREDUCE=1
GGML_GLM_ATTN_TP=1

# Fusions: all of these were already enabled in the staged 5.3 bring-up and
# produced correct output on this quant, so they carry over unchanged.
GGML_CPU_MOE_GATE_UP_FUSION=1
GGML_CPU_FFN_GATE_UP_FUSION=1
GGML_CPU_MOE_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_TILE=192
GGML_CPU_IQ3_XXS_MOE_2ROW=1
GGML_CPU_MOE_SINGLE_TOKEN_THREADS=8

# Repacks off: RAM, see header. Also note this quant is IQ3_XXS/IQ4_XS-mixed,
# and there is no IQ4_XS repack gate, so the win would be partial anyway.
GGML_CPU_NUMA_REPACK=0
GGML_CPU_IQ2_XS_REPACK=0
GGML_CPU_IQ3_XXS_REPACK=0
GGML_CPU_Q5_K_REPACK=0
GGML_CPU_REPACK_LOAD_THREADS=16
