# 2026-09-06: GLM-5.2 retired and its files deleted. This default config now mirrors the live
# glm53-sr950.service profile (model.glm53-q4-fast-v5b-ngram.env). The previous GLM-5.2 config is
# kept as model.env.bak-20260906-glm52-retired.

# GLM-5.3 full UD-Q4_K_XL "fast" profile (2026-09-01): production profile plus the
# scheduler + kernel changes from GLM53-MAX-TOKS-PLAN.md section 7. Requires the
# build-dev2 engine (spin dispatch, fused in-graph all-reduce, shared-expert split,
# q_a/kv_a k-split, x16 VNNI kernels, load-time requantization).
GLM_BINARY=/home/user/InfoSystemic/AI-Server/engines/llama.cpp-sr950-glm/build-dev2/bin/llama-server
GLM_MODEL=/models/GLM-5.3-GGUF/UD-Q4_K_XL/GLM-5.3-UD-Q4_K_XL-00001-of-00011.gguf
GLM_HOST=0.0.0.0
GLM_PORT=18091
GLM_CONTEXT_SIZE=32768
GLM_PARALLEL=1
GLM_BATCH_SIZE=512
GLM_UBATCH_SIZE=256
GLM_THREADS=15
GLM_CACHE_TYPE_K=q8_0
GLM_CACHE_TYPE_V=q8_0
GLM_ALIASES=glm-sr950,glm-sr950-agentic,glm-5.3-sr950,glm-5.3,glm53,GLM-5.3
GLM_BACKEND_MODE=numa-tensor
GLM_LOG_VERBOSITY=2
GLM_CHAT_TEMPLATE_FILE=/home/user/InfoSystemic/AI-Server/serving/glm-sr950/chat-template-glm-5.3-llamacpp.jinja
GLM_REASONING_PRESERVE=1

GLM_SPEC_TYPE=ngram-mod,draft-mtp
GLM_SPEC_DRAFT_N_MAX=32
GLM_SPEC_DRAFT_N_DEFAULT=2
GLM_SPEC_DRAFT_N_MIN=0
GLM_SPEC_DRAFT_P_MIN=0
GLM_SPEC_CACHE_TYPE_K=q8_0
GLM_SPEC_CACHE_TYPE_V=q8_0
GLM_SPEC_THREADS=15
GLM_SPEC_THREADS_BATCH=15
GLM_MTP_MODEL=/dev/shm/GLM-5.3-MTP-HYBRID-Q4L-Q6H-OUTQ4.gguf
GLM_MTP_DEVICE=CPU-NUMA0,CPU-NUMA1,CPU-NUMA2,CPU-NUMA3
GLM_MTP_GPU_LAYERS=all
GLM_SPEC_NGRAM_MOD_N_MAX=64
GLM_SPEC_NGRAM_MOD_N_MIN=2
GLM_SPEC_NGRAM_MOD_N_MATCH=8

GGML_CPU_NUMA_DEVICES=1
GGML_CPU_NUMA_THREADS=15
GGML_CPU_NUMA_POLL=100
GGML_CPU_NUMA_HUGEPAGES=0
GGML_CPU_NUMA_DIRECT_ALLREDUCE=1
GGML_GLM_ATTN_TP=1
GGML_GLM_OUTPUT_TP=1

# --- new in the fast profile ---
GGML_CPU_NUMA_FUSED_REDUCE=1
GGML_CPU_NUMA_DISPATCH_SPIN_US=20000
GGML_GLM_SHEXP_TP=1
GGML_GLM_QA_TP=2
GGML_CPU_SINGLE_TASK_MAX_ELEMENTS=32768
GGML_CPU_X16_Q4_K=1
GGML_CPU_X16_Q5_K=1
GGML_CPU_X16_Q6_K=1
GGML_CPU_ATTN_REQUANT=q5_K
GGML_CPU_SHEXP_REQUANT=q5_K
GGML_CPU_OUTPUT_REQUANT=q6_K

LLAMA_MTP_SKIP_INVALID_PREFIX_ROW=0
LLAMA_MTP_TRIM_STALE_KV=1
LLAMA_MTP_DEFER_ACCEPT_REFRESH=0

GGML_CPU_MOE_GATE_UP_FUSION=1
GGML_CPU_FFN_GATE_UP_FUSION=1
GGML_CPU_MOE_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_TILE=192
GGML_CPU_IQ3_XXS_MOE_2ROW=1
GGML_CPU_MOE_SINGLE_TOKEN_THREADS=15

GGML_CPU_NUMA_REPACK=1
GGML_CPU_IQ2_XS_REPACK=0
GGML_CPU_IQ3_XXS_REPACK=0
GGML_CPU_Q5_K_REPACK=1
GGML_CPU_Q5_K_REPACK_MOE_DOWN=1
GGML_CPU_Q8_0_REPACK=1
GGML_CPU_Q8_0_REPACK_FFN=1
GGML_CPU_Q8_0_REPACK_X_TILE=auto
GGML_CPU_REPACK_LOAD_THREADS=16

# --- v3 addition ---
# F32 router weights stored as F16 (halves the 6.3 MB per layer per socket)
GGML_CPU_ROUTER_F16=1

# --- v5b VERIFIED stack (2026-09-02): correct on the full model (17*23 -> 391, agentic replay 3/3) ---
# several unrelated partial tensors share one all-reduce boundary (q_a+kv_a, MoE+shared expert)
GGML_CPU_NUMA_MERGE_REDUCE=1
# per-head k_b/v_b matmuls through the 16-row VNNI Q8_0 kernel
GGML_CPU_X16_ATTN3D=1
# dense attention while the KV length is within the indexer top-k (2048): skips the indexer
# queries/scoring/top-k and three mask ops per layer, keeps indexer keys current
# dispatch threads: 300 us hard spin, then sched_yield polling (two contexts share cores)
GGML_CPU_NUMA_DISPATCH_HARD_SPIN_US=300
# NOTE: GGML_GLM_DSA_DENSE and GGML_CPU_X16_DUAL are deliberately ABSENT.
# v6 (= this + those two) produced fluent nonsense on the full model (17*23 -> "0.5, 0.5, 0.5",
# agentic replay 0/3) despite passing the 4-layer first-token oracle. Do not re-enable without
# a full-model semantic check.
