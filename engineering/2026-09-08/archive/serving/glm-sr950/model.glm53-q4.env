# GLM-5.3 full (non-Flash) UD-Q4_K_XL profile for the four-socket SR950.
# The model stays on disk. The meta backend creates one node-local shard per
# socket and repacks Q4_K/Q5_K weights into their AVX-512/VNNI layouts.
GLM_BINARY=/home/kwebb/InfoSystemic/AI-Server/engines/llama.cpp-sr950-glm/build-sr950-glm/bin/llama-server
GLM_MODEL=/models/GLM-5.3-GGUF/UD-Q4_K_XL/GLM-5.3-UD-Q4_K_XL-00001-of-00011.gguf
GLM_HOST=127.0.0.1
GLM_PORT=18091
GLM_CONTEXT_SIZE=32768
GLM_PARALLEL=1
GLM_BATCH_SIZE=512
GLM_UBATCH_SIZE=256
GLM_THREADS=16
GLM_CACHE_TYPE_K=q8_0
GLM_CACHE_TYPE_V=q8_0
GLM_ALIASES=glm-sr950,glm-sr950-agentic,glm-5.3-sr950,glm-5.3,glm53,GLM-5.3
GLM_BACKEND_MODE=numa-tensor
GLM_LOG_VERBOSITY=2
GLM_CHAT_TEMPLATE_FILE=/home/kwebb/InfoSystemic/AI-Server/serving/glm-sr950/chat-template-glm-5.3-llamacpp.jinja
GLM_REASONING_PRESERVE=1

# Same-version NextN/MTP draft extracted from the full GLM-5.3 checkpoint.
# Shard its output and NextN weights socket-locally across the same four NUMA
# devices. A 2026-08-31 single-node A/B was rejected: exact-output throughput
# fell from 7.90 to 6.16 tok/s, acceptance fell from 93.5% to 67.5%, and prompt
# reuse triggered an invalid deferred-refresh error on the next request.
# Measured 2026-08-29 on the live Q4_K_XL service (general harness, seed 42):
# raw 4.62 tok/s; n64/p0.8 -> 5.51; n64/p0.9 -> 4.25; n2/p0 -> 6.27-6.69.
# Allocate enough speculative positions to test the high-acceptance agentic
# path, while ordinary requests retain the general-workload winner at depth 2.
# The request-scoped coding profile n18/p0.75 sustained 13.308 and 12.546
# tok/s in two clean 3/3-correct runs (combined: 12.920 tok/s over 1,142
# output tokens). Send both speculative.n_max and speculative.p_min.
# 2026-08-29: was `ngram-mod,draft-mtp`. That composite is accepted by argument
# parsing AND by startup, then fails EVERY completion with
#   500 decode() failed: failed to process speculative batch
# while /health still returns ok, so nothing alerts. Sending
# speculative.n_max=0 per request does not avoid it either -- the speculative
# context is built at startup. Restarting with draft-mtp alone fixed it and was
# re-verified (17*23 -> 391; exact passage reproduction on the replay workload).
# Do not restore the composite without sending a real completion afterwards.
GLM_SPEC_TYPE=draft-mtp
GLM_SPEC_DRAFT_N_MAX=32
GLM_SPEC_DRAFT_N_DEFAULT=2
GLM_SPEC_DRAFT_N_MIN=0
GLM_SPEC_DRAFT_P_MIN=0
GLM_SPEC_CACHE_TYPE_K=q8_0
GLM_SPEC_CACHE_TYPE_V=q8_0
GLM_SPEC_THREADS=16
GLM_SPEC_THREADS_BATCH=16
# Trial artifact: identical to the production hybrid except output.weight is
# Q4_K rather than Q6_K. Its compact repack measured 5.688 ms versus 8.124 ms.
GLM_MTP_MODEL=/dev/shm/GLM-5.3-MTP-HYBRID-Q4L-Q6H-OUTQ4.gguf
GLM_MTP_DEVICE=CPU-NUMA0,CPU-NUMA1,CPU-NUMA2,CPU-NUMA3
GLM_MTP_GPU_LAYERS=all
# Keep alias-only p_min disabled: the coding winner requires n_max=18 and
# p_min=0.75 together, while this server intentionally defaults to n_max=2.
# GLM_SPEC_ALIAS_P_MIN=glm-sr950-agentic:0.75
GLM_SPEC_NGRAM_MOD_N_MAX=64
GLM_SPEC_NGRAM_MOD_N_MIN=48
GLM_SPEC_NGRAM_MOD_N_MATCH=24

GGML_CPU_NUMA_DEVICES=1
GGML_CPU_NUMA_THREADS=16
GGML_CPU_NUMA_POLL=100
GGML_CPU_NUMA_HUGEPAGES=0
GGML_CPU_NUMA_DIRECT_ALLREDUCE=1
GGML_GLM_ATTN_TP=1
GGML_GLM_OUTPUT_TP=1

# Keep the one-layer NextN cache aligned with the accepted target prefix.
# The model's initial zero-hidden prefix row is retained: omitting it reduced
# deterministic depth-2 acceptance from 76% to 57% in the live Q4 sweep.
LLAMA_MTP_SKIP_INVALID_PREFIX_ROW=0
LLAMA_MTP_TRIM_STALE_KV=1
# Do not defer accepted-token refresh across requests. With prompt-cache reuse,
# the deferred anchor retained the previous request position and every later
# completion failed with "invalid deferred MTP refresh" while health stayed OK.
LLAMA_MTP_DEFER_ACCEPT_REFRESH=0

GGML_CPU_MOE_GATE_UP_FUSION=1
GGML_CPU_FFN_GATE_UP_FUSION=1
GGML_CPU_MOE_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_TILE=192
GGML_CPU_IQ3_XXS_MOE_2ROW=1
GGML_CPU_MOE_SINGLE_TOKEN_THREADS=16

GGML_CPU_NUMA_REPACK=1
GGML_CPU_IQ2_XS_REPACK=0
GGML_CPU_IQ3_XXS_REPACK=0
GGML_CPU_Q5_K_REPACK=1
# The original Q5_K MoE-down layout won its isolated n=16/17 microbenchmark,
# but reduced the full depth-16 replay from 11.47 to 10.55 tok/s. Keep the
# expanded service layout; isolated kernel timing did not predict whole-model
# scheduling and memory behavior.
GGML_CPU_Q5_K_REPACK_MOE_DOWN=1
GGML_CPU_Q8_0_REPACK=1
GGML_CPU_Q8_0_REPACK_FFN=1
GGML_CPU_Q8_0_REPACK_X_TILE=auto
GGML_CPU_REPACK_LOAD_THREADS=16
