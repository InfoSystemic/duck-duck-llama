GLM_BINARY=/home/user/InfoSystemic/AI-Server/engines/llama.cpp-sr950-glm/build-sr950-glm-pgo-q5-r8-20260826/bin/llama-server
GLM_MODEL=/dev/shm/ai-models/GLM-5.3-GGUF/UD-Q3_K_XL/GLM-5.3-UD-Q3_K_XL-00001-of-00009.gguf
GLM_HOST=127.0.0.1
GLM_PORT=18091
# 256K is the measured performance/headroom tier. 1M is viable but consumes
# about 563.5 GiB RSS and reduces short-context replay/prompt throughput.
GLM_CONTEXT_SIZE=32768
GLM_PARALLEL=1
GLM_BATCH_SIZE=256
GLM_UBATCH_SIZE=128
GLM_THREADS=64
GLM_CACHE_TYPE_K=q8_0
GLM_CACHE_TYPE_V=q8_0
GLM_ALIASES=glm-sr950,glm-sr950-agentic,glm-5.3-sr950,glm-5.3,glm53,GLM-5.3
GLM_BACKEND_MODE=cpu-repack
GLM_LOG_VERBOSITY=2

# Composite speculative decoding is a measured production win on this quant.
# MTP confidence gating handles novel text; ngram-mod accelerates file replay.
GLM_SPEC_TYPE=none
GLM_SPEC_DRAFT_N_MAX=64
GLM_SPEC_DRAFT_N_MIN=0
GLM_SPEC_DRAFT_P_MIN=0.8
GLM_SPEC_CACHE_TYPE_K=q8_0
GLM_SPEC_CACHE_TYPE_V=q8_0
GLM_SPEC_THREADS=16
GLM_SPEC_THREADS_BATCH=16
# Keep the 4.6 GiB NextN model and all of its draft work local to one socket.
# The target remains tensor-sharded across all four NUMA backends.
GLM_MTP_MODEL=/home/user/.local/share/ai-models/GLM-5.2-UD-Q2_K_XL/GLM-5.2-MTP-UD-Q2_K_XL.gguf
GLM_MTP_DEVICE=CPU-NUMA0
GLM_MTP_GPU_LAYERS=all

# The stable alias keeps the general-workload optimum above. The agentic alias
# selects the independently measured file-replay optimum unless a request
# explicitly supplies its own dotted or nested speculative.p_min value.
GLM_SPEC_ALIAS_P_MIN=

# ngram-mod drafts only after a safe 24-token match and emits at least 48 tokens.
# This avoids upstream's short-match warning while accelerating file replay.
GLM_SPEC_NGRAM_MOD_N_MAX=64
GLM_SPEC_NGRAM_MOD_N_MIN=48
GLM_SPEC_NGRAM_MOD_N_MATCH=24

# Four-socket SR950 tensor-parallel backend and measured production gates.
GGML_CPU_NUMA_DEVICES=0
GGML_CPU_NUMA_THREADS=16
GGML_CPU_NUMA_POLL=50
GGML_CPU_NUMA_HUGEPAGES=1
GGML_CPU_NUMA_DIRECT_ALLREDUCE=0
GGML_GLM_ATTN_TP=0
GGML_CPU_MOE_GATE_UP_FUSION=1
GGML_CPU_FFN_GATE_UP_FUSION=1
GGML_CPU_MOE_WEIGHTED_SUM_FUSION=1
# IQ3 routed down projection writes the router-weighted result directly.  The
# 192-row tile won the production-shape sweep and the 256-expert check is exact.
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_FUSION=1
GGML_CPU_MOE_DOWN_WEIGHTED_SUM_TILE=192
GGML_CPU_IQ3_XXS_MOE_2ROW=1
# Eight active workers minimize single-token routed-expert latency; the
# scheduler automatically retains all 16 workers for multi-token verification.
GGML_CPU_MOE_SINGLE_TOKEN_THREADS=8

# Dormant operator timing: no profiling occurs unless this arm file exists.
# Create it after the first streamed token to sample decode rather than prompt
# setup.  Seven hundred per-device subgraphs cover one complete 79-layer token;
# 64 covered only the first eight layers and is not a full-model profile.
# Removing the arm file after completion allows a future run to re-arm.
GGML_CPU_OP_PROFILE=*
GGML_CPU_OP_PROFILE_ARM_FILE=/tmp/glm-sr950-op-profile.arm
GGML_CPU_OP_PROFILE_SKIP=0
GGML_CPU_OP_PROFILE_COUNT=700

# Lossless IQ2_XS/IQ3_XXS/Q5_K VNNI repacks, allocated per NUMA node.  Packed
# nibble IQ2 improves the exact fused 6144x512 gate/up path by 17.4% at one
# worker and 9.4% at four.  Packed nibble IQ3 retains its existing four-bit
# footprint and improves the exact fused 512x6144 down path at the production
# 16 workers from 0.331 to 0.218 ms/token (batch 1) and 1.111 to 0.697 ms
# (batch 4). Packed 5-bit Q5 cuts the cold 4096x6144 matrix footprint from
# 27.13 to 17.69 MB and latency from 0.310 to 0.256 ms.  The PGO corpus covers
# the real expert shapes at 1/2/4/8/16 rows.
GGML_CPU_NUMA_REPACK=0
GGML_CPU_IQ2_XS_REPACK=0
GGML_CPU_IQ3_XXS_REPACK=0
GGML_CPU_Q5_K_REPACK=0
GGML_CPU_REPACK_LOAD_THREADS=16
GLM_CHAT_TEMPLATE_FILE=/home/user/InfoSystemic/AI-Server/serving/glm-sr950/chat-template-glm-5.3-llamacpp.jinja
GLM_REASONING_PRESERVE=1
GLM_CPU_REPACK_NUMA_POLICY=interleave
