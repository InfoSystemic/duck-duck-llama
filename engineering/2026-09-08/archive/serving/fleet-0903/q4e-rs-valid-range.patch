+static bool test_snapshot_range(const common_params & params, llama_model * model, const int n_vocab) {
+    llama_context * ctx = make_ctx(params, model);
+    llama_context * ref = make_ctx(params, model);
+    if (!ctx || !ref) {
+        llama_free(ctx);
+        llama_free(ref);
+        return false;
+    }
+    const auto cleanup = [&]() { llama_free(ctx); llama_free(ref); };
+    std::vector<llama_token> tokens(16);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        tokens[i] = (llama_token) ((7*i + 1) % n_vocab);
+    }
+    const auto reject_without_change = [&](llama_pos pos) {
+        const auto mem = llama_get_memory(ctx);
+        const llama_pos before = llama_memory_seq_pos_max(mem, 0);
+        const bool rejected = !llama_memory_seq_rm(mem, 0, pos, -1);
+        return rejected && llama_memory_seq_pos_max(mem, 0) == before;
+    };
+    const auto compare_next = [&](llama_pos pos) {
+        if (!decode_one(ctx, tokens[pos], pos) || !decode_one(ref, tokens[pos], pos)) {
+            return false;
+        }
+        const float * a = llama_get_logits_ith(ctx, 0);
+        const float * b = llama_get_logits_ith(ref, 0);
+        if (!a || !b) { return false; }
+        for (int i = 0; i < n_vocab; ++i) {
+            if (!std::isfinite(a[i]) || !std::isfinite(b[i]) || std::fabs(a[i] - b[i]) > 1e-7f) {
+                return false;
+            }
+        }
+        return true;
+    };
+    bool ok = decode_tokens(ctx, tokens, 9) && decode_tokens(ref, tokens, 9);
+    ok = ok && compare_next(9);
+    // A single-token decode overwrites slot zero without shifting older snapshots.
+    ok = ok && reject_without_change(9) && reject_without_change(7) && compare_next(10);
+    for (const auto flags : { llama_state_seq_flags(0), llama_state_seq_flags(LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) }) {
+        if (!ok) { break; }
+        llama_memory_clear(llama_get_memory(ctx), true);
+        llama_memory_clear(llama_get_memory(ref), true);
+        ok = decode_tokens(ctx, tokens, 9) && decode_tokens(ref, tokens, 9);
+        common_prompt_checkpoint checkpoint;
+        checkpoint.update_tgt(ctx, 0, flags);
+        checkpoint.load_tgt(ctx, 0, flags);
+        // A checkpoint contains the selected state, without its rollback history.
+        ok = ok && reject_without_change(8) && compare_next(9);
+    }
+    fprintf(stderr, "%s : stale snapshot rejection and continuation %s\n", __func__, ok ? "passed" : "failed");
+    cleanup();
+    return ok;
+}
