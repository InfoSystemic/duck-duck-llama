+// Compose one Meta buffer type per matching per-device extra buffer type (the
+// CPU backend's node-local repack buffers), so a tensor-parallel load can opt
+// into repacking without losing the split. Returns a nullptr-terminated array;
+// a single {nullptr} means the devices do not agree on a set of extras.
+ggml_backend_buffer_type_t * ggml_backend_meta_device_get_extra_bufts(ggml_backend_dev_t dev) {
+    static std::mutex mutex;
+    static std::map<ggml_backend_dev_t, std::vector<ggml_backend_buffer_type_t>> extra_bufts_by_dev;
+
+    GGML_ASSERT(ggml_backend_dev_is_meta(dev));
+
+    std::lock_guard<std::mutex> lock(mutex);
+    auto cached = extra_bufts_by_dev.find(dev);
+    if (cached != extra_bufts_by_dev.end()) {
+        return cached->second.data();
+    }
+
+    std::vector<std::vector<ggml_backend_buffer_type_t>> simple_extra_bufts;
+    const size_t n_devs = ggml_backend_meta_dev_n_devs(dev);
+    simple_extra_bufts.reserve(n_devs);
+
+    size_t n_extra_bufts = 0;
+    for (size_t i = 0; i < n_devs; ++i) {
+        ggml_backend_dev_t simple_dev = ggml_backend_meta_dev_simple_dev(dev, i);
+        if (ggml_backend_dev_type(simple_dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            auto result = extra_bufts_by_dev.emplace(dev, std::vector<ggml_backend_buffer_type_t> { nullptr });
+            return result.first->second.data();
+        }
+
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(simple_dev);
+        auto get_extra_bufts = reg == nullptr ? nullptr : (ggml_backend_dev_get_extra_bufts_t)
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts");
+        ggml_backend_buffer_type_t * simple_extras = get_extra_bufts == nullptr ? nullptr : get_extra_bufts(simple_dev);
+
+        std::vector<ggml_backend_buffer_type_t> current;
+        while (simple_extras != nullptr && *simple_extras != nullptr) {
+            current.push_back(*simple_extras++);
+        }
+        if (i == 0) {
+            n_extra_bufts = current.size();
+        } else if (current.size() != n_extra_bufts) {
+            auto result = extra_bufts_by_dev.emplace(dev, std::vector<ggml_backend_buffer_type_t> { nullptr });
+            return result.first->second.data();
+        }
+        simple_extra_bufts.push_back(std::move(current));
+    }
+
+    std::vector<ggml_backend_buffer_type_t> meta_extra_bufts;
+    meta_extra_bufts.reserve(n_extra_bufts + 1);
+    for (size_t i = 0; i < n_extra_bufts; ++i) {
+        std::vector<ggml_backend_buffer_type_t> simple_bufts;
+        simple_bufts.reserve(n_devs);
+        for (size_t j = 0; j < n_devs; ++j) {
+            simple_bufts.push_back(simple_extra_bufts[j][i]);
+        }
+        meta_extra_bufts.push_back(ggml_backend_meta_buffer_type(dev, simple_bufts));
+    }
+    meta_extra_bufts.push_back(nullptr);
+
+    auto result = extra_bufts_by_dev.emplace(dev, std::move(meta_extra_bufts));
+    return result.first->second.data();
 }
 
