+// ---------------------------------------------------------------------------------------------
+// Fused in-graph all-reduce for CPU NUMA devices.
+//
+// Instead of returning to the main thread at every tensor-parallel boundary (one dispatch
+// round trip + an OpenMP region start per subgraph, ~157-400 times per token), each device
+// runs the whole token as ONE graph. A custom op is inserted at every boundary: all devices
+// spin-synchronize, each device sums its slice of the F32 partial across the four device
+// buffers and writes the result into all of them, then they synchronize again.
+// ---------------------------------------------------------------------------------------------
+#define GGML_META_FUSED_MAX_DEVS 8
+
+#define GGML_META_FUSED_MAX_RED 4
+struct ggml_backend_meta_fused_reduce_desc {
+    ggml_tensor * nodes[GGML_META_FUSED_MAX_RED][GGML_META_FUSED_MAX_DEVS] = {};
+    bool          active[GGML_META_FUSED_MAX_RED][GGML_META_FUSED_MAX_DEVS] = {};
+    int           n_red = 1;
+    int           n_devs = 0;
+    int64_t       single_task_max_elements = 0;
+    alignas(64) std::atomic<int> arrive1{0};
+    alignas(64) std::atomic<int> arrive2{0};
+    alignas(64) std::atomic<int> done_threads[GGML_META_FUSED_MAX_DEVS];
+    ggml_backend_meta_fused_reduce_desc() {
+        for (int j = 0; j < GGML_META_FUSED_MAX_DEVS; j++) {
+            done_threads[j].store(0, std::memory_order_relaxed);
+        }
+    }
+    void reset() {
+        arrive1.store(0, std::memory_order_relaxed);
+        arrive2.store(0, std::memory_order_relaxed);
+        for (int j = 0; j < GGML_META_FUSED_MAX_DEVS; j++) {
+            done_threads[j].store(0, std::memory_order_relaxed);
+        }
+    }
+};
+
+struct ggml_backend_meta_fused_reduce_userdata {
+    ggml_backend_meta_fused_reduce_desc * desc;
+    int dev;
+};
+
+static inline void ggml_backend_meta_fused_relax() {
+#if defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#endif
+}
+
+static inline void ggml_backend_meta_fused_spin_until(const std::atomic<int> & v, int target, const char * what) {
+    int spins = 0;
+    int64_t t0 = 0;
+    while (v.load(std::memory_order_acquire) < target) {
+        ggml_backend_meta_fused_relax();
+        if ((++spins & 4095) == 0) {
+            const int64_t now = ggml_time_us();
+            if (t0 == 0) {
+                t0 = now;
+            } else if (now - t0 > 120 * 1000 * 1000) {
+                GGML_ABORT("fused NUMA all-reduce timed out waiting for %s (%d/%d)", what, v.load(), target);
+            }
+        }
+    }
+}
+
+static void ggml_backend_meta_fused_reduce_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(dst);
+    auto * ud = (ggml_backend_meta_fused_reduce_userdata *) userdata;
+    ggml_backend_meta_fused_reduce_desc * d = ud->desc;
+    const int j = ud->dev;
+    const int n = d->n_devs;
+    int64_t ne_max = 0;
+    for (int r = 0; r < d->n_red; r++) {
+        ne_max = std::max<int64_t>(ne_max, ggml_nelements(d->nodes[r][j]));
+    }
+    const int nth_reduce = d->single_task_max_elements > 0 && ne_max <= d->single_task_max_elements ? 1 : nth;
+
+    // Small reductions move too little data to justify waking every worker on every NUMA
+    // device.  The inactive workers meet the graph's normal post-node barrier while worker
+    // zero performs the cross-device synchronization and reduction.
+    if (ith >= nth_reduce) {
+        return;
+    }
+
+    // phase 1: every device has produced its partial(s)
+    if (ith == 0) {
+        d->arrive1.fetch_add(1, std::memory_order_acq_rel);
+    }
+    ggml_backend_meta_fused_spin_until(d->arrive1, n, "arrive1");
+
+    for (int r = 0; r < d->n_red; r++) {
+        const int64_t ne = ggml_nelements(d->nodes[r][j]);
+        const int64_t per_dev = (ne + n - 1) / n;
+        const int64_t d_start = std::min<int64_t>(ne, (int64_t) j * per_dev);
+        const int64_t d_end   = std::min<int64_t>(ne, d_start + per_dev);
+        const int64_t per_thr = (d_end - d_start + nth_reduce - 1) / nth_reduce;
+        const int64_t t_start = std::min<int64_t>(d_end, d_start + (int64_t) ith * per_thr);
+        const int64_t t_end   = std::min<int64_t>(d_end, t_start + per_thr);
+
+        float * p[GGML_META_FUSED_MAX_DEVS];
+        for (int jj = 0; jj < n; jj++) {
+            p[jj] = (float *) d->nodes[r][jj]->data;
+        }
+        bool all_active = true;
+        for (int jj = 0; jj < n; jj++) {
+            all_active = all_active && d->active[r][jj];
+        }
+        if (n == 4 && all_active) {
+            float * GGML_RESTRICT p0 = p[0];
+            float * GGML_RESTRICT p1 = p[1];
+            float * GGML_RESTRICT p2 = p[2];
+            float * GGML_RESTRICT p3 = p[3];
+            for (int64_t k = t_start; k < t_end; ++k) {
+                const float sum = (p0[k] + p1[k]) + (p2[k] + p3[k]);
+                p0[k] = sum;
+                p1[k] = sum;
+                p2[k] = sum;
+                p3[k] = sum;
+            }
+        } else {
+            for (int64_t k = t_start; k < t_end; ++k) {
+                float sum = 0.0f;
+                for (int jj = 0; jj < n; jj++) {
+                    if (d->active[r][jj]) {
+                        sum += p[jj][k];
+                    }
+                }
+                for (int jj = 0; jj < n; jj++) {
+                    p[jj][k] = sum;
+                }
+            }
+        }
+    }
+
+    // phase 2: all threads of this device done -> device done; wait for all devices
+    if (d->done_threads[j].fetch_add(1, std::memory_order_acq_rel) + 1 == nth_reduce) {
+        d->arrive2.fetch_add(1, std::memory_order_acq_rel);
+    }
+    ggml_backend_meta_fused_spin_until(d->arrive2, n, "arrive2");
+}
