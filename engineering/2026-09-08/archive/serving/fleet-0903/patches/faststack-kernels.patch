+static void ggml_compute_forward_mul_mat_swiglu_fused(
+        const struct ggml_compute_params * params,
+        const struct ggml_tensor * gate,
+        const struct ggml_tensor * up,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * src0 = gate->src[0];
+    const struct ggml_tensor * src0_up = up->src[0];
+    const struct ggml_tensor * src1 = gate->src[1];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const enum ggml_type vec_dot_type = type_traits_cpu[src0->type].vec_dot_type;
+    const ggml_from_float_t from_float = type_traits_cpu[vec_dot_type].from_float;
+
+    GGML_ASSERT(src0_up->type == src0->type);
+    GGML_ASSERT(ggml_are_same_shape(src0, src0_up));
+    GGML_ASSERT(up->src[1] == src1);
+    GGML_ASSERT(ggml_are_same_shape(gate, up));
+    GGML_ASSERT(ggml_are_same_shape(gate, dst));
+    GGML_ASSERT(type_traits_cpu[src0->type].nrows == 1);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(nb00 == ggml_type_size(src0->type));
+    GGML_ASSERT(src0_up->nb[0] == ggml_type_size(src0_up->type));
+    GGML_ASSERT(nb10 == ggml_type_size(src1->type));
+    GGML_ASSERT(nb0 == sizeof(float));
+
+    if (src1->type != vec_dot_type) {
+        char * wdata = params->wdata;
+        const size_t nbw0 = ggml_type_size(vec_dot_type);
+        const size_t nbw1 = ggml_row_size(vec_dot_type, ne10);
+        const size_t nbw2 = nbw1*ne11;
+        const size_t nbw3 = nbw2*ne12;
+
+        GGML_ASSERT(src1->type == GGML_TYPE_F32);
+        GGML_ASSERT(params->wsize >= ne13*nbw3);
+        for (int64_t i13 = 0; i13 < ne13; ++i13) {
+            for (int64_t i12 = 0; i12 < ne12; ++i12) {
+                for (int64_t i11 = 0; i11 < ne11; ++i11) {
+                    const size_t bs = ggml_blck_size(vec_dot_type);
+                    const int64_t block_start = (ith*ne10/bs)/nth;
+                    const int64_t block_end = ((ith + 1)*ne10/bs)/nth;
+                    from_float(
+                        (float *) ((char *) src1->data + i13*nb13 + i12*nb12 + i11*nb11 + block_start*bs*nb10),
+                        (void *) (wdata + i13*nbw3 + i12*nbw2 + i11*nbw1 + block_start*nbw0),
+                        (block_end - block_start)*bs);
+                }
+            }
+        }
+    }
+
+    if (ith == 0) {
+        atomic_store_explicit(&params->threadpool->current_chunk, nth, memory_order_relaxed);
+    }
+    ggml_barrier(params->threadpool);
+
+    const int64_t nr0 = ne0;
+    const int64_t nr1 = ne1*ne2*ne3;
+    int chunk_size = nr0 == 1 || nr1 == 1 ? 64 : 16;
+    int64_t nchunk0 = (nr0 + chunk_size - 1)/chunk_size;
+    int64_t nchunk1 = (nr1 + chunk_size - 1)/chunk_size;
+    if (nchunk0*nchunk1 < nth*4 || ggml_is_numa()) {
+        nchunk0 = nr0 > nr1 ? nth : 1;
+        nchunk1 = nr0 > nr1 ? 1 : nth;
+    }
+
+    const int64_t dr0 = (nr0 + nchunk0 - 1)/nchunk0;
+    const int64_t dr1 = (nr1 + nchunk1 - 1)/nchunk1;
+    int current_chunk = ith;
+    const void * wdata = src1->type == vec_dot_type ? src1->data : params->wdata;
+
+    while (current_chunk < nchunk0*nchunk1) {
+        const int64_t ith0 = current_chunk % nchunk0;
+        const int64_t ith1 = current_chunk / nchunk0;
+        const int64_t ir0_start = dr0*ith0;
+        const int64_t ir0_end = MIN(ir0_start + dr0, nr0);
+        const int64_t ir1_start = dr1*ith1;
+        const int64_t ir1_end = MIN(ir1_start + dr1, nr1);
+
+        ggml_compute_forward_mul_mat_swiglu_one_chunk(
+            dst, gate, up, ir0_start, ir0_end, ir1_start, ir1_end, wdata);
+
+        if (nth >= nchunk0*nchunk1) {
+            break;
+        }
+        current_chunk = atomic_fetch_add_explicit(&params->threadpool->current_chunk, 1, memory_order_relaxed);
+    }
+}
