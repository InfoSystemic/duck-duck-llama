 conversion/qwen4exp.py         | 68 +++++++++++++++++++++++++++++-----
 gguf-py/gguf/tensor_mapping.py | 10 +++++
 2 files changed, 68 insertions(+), 10 deletions(-)

diff --git a/conversion/qwen4exp.py b/conversion/qwen4exp.py
