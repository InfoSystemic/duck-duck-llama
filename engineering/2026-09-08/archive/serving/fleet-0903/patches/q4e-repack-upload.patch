+    const size_t n_bufs = ggml_backend_meta_buffer_n_bufs(buffer);
+    if (n_bufs <= 1) {
+        return false;
+    }
+    for (size_t j = 0; j < n_bufs; ++j) {
+        const ggml_backend_buffer_t simple_buffer = ggml_backend_meta_buffer_simple_buffer(buffer, j);
+        ggml_backend_dev_t simple_dev = ggml_backend_buft_get_device(simple_buffer->buft);
+        const char * name = simple_dev == nullptr ? nullptr : ggml_backend_dev_name(simple_dev);
+        if (simple_dev == nullptr || ggml_backend_dev_type(simple_dev) != GGML_BACKEND_DEVICE_TYPE_CPU ||
+                name == nullptr || strncmp(name, "CPU-NUMA", strlen("CPU-NUMA")) != 0) {
+            return false;
+        }
+    }
+    return true;
