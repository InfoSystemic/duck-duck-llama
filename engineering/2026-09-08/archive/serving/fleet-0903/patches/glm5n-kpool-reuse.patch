+bool llm_graph_input_kpool::can_reuse(const llm_graph_params & params) {
+    static const bool enabled = []() {
+        const char * value = std::getenv("GGML_GLM5N_KPOOL_REUSE");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    if (!enabled || params.arch != LLM_ARCH_GLM5NEXT) {
+        return false;
+    }
+
+    const auto * next = static_cast<const llama_memory_hybrid_context *>(params.mctx);
+    if (next->get_idx() == nullptr || k_idxs->ne[0] != params.ubatch.n_tokens ||
+            n_kv_idx != next->get_idx()->get_n_kv()) {
+        return false;
+    }
+
+    const auto & ubatch = params.ubatch;
+    const int64_t n_stream = params.cparams.kv_unified ? 1 : ubatch.n_seqs_unq;
+    if (n_stream == 0 || ubatch.n_tokens % n_stream != 0 || ubatch.n_seqs_unq % n_stream != 0) {
+        return false;
+    }
+    const bool scoring = params.cparams.n_ctx > params.hparams.indexer_top_k + kpool - 1;
+    if (scoring != (pool_cells != nullptr)) {
+        return false;
+    }
+    if (scoring) {
+        const int64_t n_kv = next->get_attn()->get_n_kv();
+        const int64_t n_tps = ubatch.n_tokens / n_stream;
+        const int64_t n_pools = llama_kpool_n_pools(n_kv, kpool, ubatch.n_seqs_unq / n_stream);
+        auto shape = [](const ggml_tensor * tensor, int64_t a, int64_t b, int64_t c, int64_t d) {
+            return tensor != nullptr && tensor->ne[0] == a && tensor->ne[1] == b &&
+                tensor->ne[2] == c && tensor->ne[3] == d;
+        };
+        if (!shape(pool_cells, kpool * n_pools, n_stream, 1, 1) ||
+            !shape(pool_bias, n_pools, n_tps, n_stream, 1) ||
+            !shape(sel_mask, n_kv, n_tps, 1, n_stream) ||
+            !shape(cand_mask, n_kv, n_tps, 1, n_stream) ||
+            (pool_bias_f16 != nullptr && !shape(pool_bias_f16, n_pools, n_tps, 1, n_stream))) {
+            return false;
+        }
+    }
+
+    mctx_attn = next->get_attn();
+    mctx_idx = next->get_idx();
+    return true;
+}
