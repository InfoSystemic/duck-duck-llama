+static inline void ggml_backend_meta_fused_spin_until(const std::atomic<int> & v, int target, const char * what) {
+    int spins = 0;
+    int64_t t0 = 0;
+    while (v.load(std::memory_order_acquire) < target) {
+        ggml_backend_meta_fused_relax();
+        if ((++spins & 4095) == 0) {
+            const int64_t now = ggml_time_us();
+            if (t0 == 0) {
+                t0 = now;
+            } else if (now - t0 > 120 * 1000 * 1000) {
+                GGML_ABORT("fused NUMA all-reduce timed out waiting for %s (%d/%d)", what, v.load(), target);
+            }
+        }
+    }
+}
