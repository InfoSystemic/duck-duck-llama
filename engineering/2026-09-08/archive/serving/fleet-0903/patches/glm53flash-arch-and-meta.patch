+            done_threads[j].store(0, std::memory_order_relaxed);
+        }
+    }
+    void reset() {
+        arrive1.store(0, std::memory_order_relaxed);
+        arrive2.store(0, std::memory_order_relaxed);
+        for (int j = 0; j < GGML_META_FUSED_MAX_DEVS; j++) {
+            done_threads[j].store(0, std::memory_order_relaxed);
+        }
+    }
+};
