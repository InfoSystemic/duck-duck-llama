+#define GGML_META_FUSED_MAX_RED 4
+struct ggml_backend_meta_fused_reduce_desc {
+    ggml_tensor * nodes[GGML_META_FUSED_MAX_RED][GGML_META_FUSED_MAX_DEVS] = {};
+    bool          active[GGML_META_FUSED_MAX_RED][GGML_META_FUSED_MAX_DEVS] = {};
+    int           n_red = 1;
+    int           n_devs = 0;
+    int64_t       single_task_max_elements = 0;
+    alignas(64) std::atomic<int> arrive1{0};
+    alignas(64) std::atomic<int> arrive2{0};
+    alignas(64) std::atomic<int> done_threads[GGML_META_FUSED_MAX_DEVS];
