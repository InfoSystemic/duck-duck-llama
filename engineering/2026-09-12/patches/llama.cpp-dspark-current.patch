@@ -328,6 +329,30 @@ void ggml_log_callback_default(enum ggml_log_level level, const char * text, voi
 #endif
 
 
+static void ggml_madvise_hugepage(void * ptr, size_t size) {
+#if defined(__linux__) && defined(MADV_HUGEPAGE)
+    if (ptr == NULL || size < 1024ull*1024ull*1024ull || getenv("GGML_CPU_HUGEPAGES") == NULL) {
+        return;
+    }
+
+    const long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        return;
+    }
+
+    const uintptr_t addr  = (uintptr_t) ptr;
+    const uintptr_t begin = (addr + (uintptr_t) page_size - 1)/(uintptr_t) page_size*(uintptr_t) page_size;
+    const uintptr_t end   = (addr + size)/(uintptr_t) page_size*(uintptr_t) page_size;
+
+    if (end > begin && madvise((void *) begin, end - begin, MADV_HUGEPAGE) != 0) {
+        GGML_LOG_WARN("%s: madvise(MADV_HUGEPAGE) failed: %s\n", __func__, strerror(errno));
+    }
+#else
+    GGML_UNUSED(ptr);
+    GGML_UNUSED(size);
+#endif
+}
+
 void * ggml_aligned_malloc(size_t size) {
 #if defined(__s390x__)
     const int alignment = 256;
@@ -380,6 +405,7 @@ void * ggml_aligned_malloc(size_t size) {
         GGML_LOG_ERROR("%s: %s (attempted to allocate %6.2f MB)\n", __func__, error_desc, size/(1024.0*1024.0));
         return NULL;
     }
+    ggml_madvise_hugepage(aligned_memory, size);
     return aligned_memory;
 #endif
 }
