+    oa = ggml_permute(ctx0, oa, 0, 2, 1, 3);
+    oa = ggml_cont_2d(ctx0, oa, o_lora_rank*o_groups, nt);
+
+    out = build_lora_mm(wo_b, oa);
+    cb(out, "attn_out", il);
+
+    return out;
+}
