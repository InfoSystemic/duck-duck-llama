+static void ggml_compute_forward_mul_mat_id_swiglu_one_chunk(
+        struct ggml_tensor * dst,
+        const struct ggml_tensor * src0_gate,
+        const struct ggml_tensor * src0_up,
+        const struct ggml_tensor * src1,
+        const struct ggml_tensor * ids,
+        const int64_t cur_a,
+        const int64_t ir0_start,
+        const int64_t ir0_end,
+        const int64_t ir1_start,
+        const int64_t ir1_end,
+        const char * src0_gate_cur,
+        const char * src0_up_cur,
+        const struct mmid_row_mapping * matrix_rows,
+        const size_t row_size,
+        const bool src1_cont,
+        const void * wdata) {
+
+    const enum ggml_type type = src0_gate->type;
+    const ggml_vec_dot_t vec_dot = type_traits_cpu[type].vec_dot;
+    const enum ggml_type vec_dot_type = type_traits_cpu[type].vec_dot_type;
+    const int64_t ne00 = src0_gate->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const size_t nb01_gate = src0_gate->nb[1];
+    const size_t nb01_up = src0_up->nb[1];
+    const size_t nb11 = src1->nb[1];
+    const size_t nb12 = src1->nb[2];
+    const size_t nb1 = dst->nb[1];
+    const size_t nb2 = dst->nb[2];
+
+    const int64_t blck_0 = 16;
+    const int64_t blck_1 = 16;
+
+    float gate_tmp[16];
+    float up_tmp[16];
+    float out_tmp[16];
+
+    for (int64_t iir1 = ir1_start; iir1 < ir1_end; iir1 += blck_1) {
+        for (int64_t iir0 = ir0_start; iir0 < ir0_end; iir0 += blck_0) {
+            for (int64_t ir1 = iir1; ir1 < iir1 + blck_1 && ir1 < ir1_end; ++ir1) {
+                const struct mmid_row_mapping row_mapping = MMID_MATRIX_ROW(cur_a, ir1);
+                const int id = row_mapping.i1;
+                const int64_t i11 = id % ne11;
+                const int64_t i12 = row_mapping.i2;
+                const char * src1_col = (const char *) wdata +
+                    (src1_cont || src1->type != vec_dot_type
+                        ? (i11 + i12*ne11)*row_size
+                        : (i11*nb11 + i12*nb12));
+                float * dst_col = (float *) ((char *) dst->data + id*nb1 + i12*nb2);
+
+                const int64_t ir0_stop = MIN(iir0 + blck_0, ir0_end);
+                for (int64_t ir0 = iir0; ir0 < ir0_stop; ++ir0) {
+                    vec_dot(ne00, &gate_tmp[ir0 - iir0], 0,
+                        src0_gate_cur + ir0*nb01_gate, 0, src1_col, 0, 1);
+                }
+
+                for (int64_t ir0 = iir0; ir0 < ir0_stop; ++ir0) {
+                    vec_dot(ne00, &up_tmp[ir0 - iir0], 0,
+                        src0_up_cur + ir0*nb01_up, 0, src1_col, 0, 1);
+                }
+
+                const int64_t n = ir0_stop - iir0;
+                ggml_vec_swiglu_f32(n, out_tmp, gate_tmp, up_tmp);
+                memcpy(&dst_col[iir0], out_tmp, n*sizeof(float));
+            }
+        }
+    }
