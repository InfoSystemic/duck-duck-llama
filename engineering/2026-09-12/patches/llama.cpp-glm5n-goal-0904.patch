+template <bool IQ3, bool SHARED_SCALE = false>
+static void ggml_gemv_iq_r16_q8_K(
+        int n, float * s, size_t bs, const void * vx, const void * vy, int nr, int nc) {
+    if constexpr (SHARED_SCALE) {
+        if (iq_r16_scale32_enabled()) {
+            for (int y = 0; y < nr; ++y) {
+                const block_q8_K * rows[] = {(const block_q8_K *) vy + y * (n / QK_K)};
+                if (iq_r16_pairgroups_enabled() && nc >= 32) {
+                    ggml_gemv_iq_r16_pairgroups<IQ3>(n, s + y * bs, bs, vx, rows[0], nc);
+                } else {
+                    ggml_gemv_iq_r16_scale32_impl<IQ3, 1>(n, s + y * bs, bs, vx, rows, nc);
+                }
+            }
+            return;
+        }
+    }
+    if (iq_r16_paired_nibbles()) {
+        ggml_gemv_iq_r16_q8_K_impl<IQ3, true>(n, s, bs, vx, vy, nr, nc);
+    } else {
+        ggml_gemv_iq_r16_q8_K_impl<IQ3, false>(n, s, bs, vx, vy, nr, nc);
+    }
+}
