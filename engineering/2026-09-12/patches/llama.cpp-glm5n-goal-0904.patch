+static bool ggml_cpu_op_profile_matches(const char * name) {
+    const char * filter = ggml_cpu_op_profile_filter;
+    if (filter == NULL || filter[0] == '\0') {
+        return false;
+    }
+    if (filter[0] == '*' && filter[1] == '\0') {
+        return true;
+    }
+    while (*filter != '\0') {
+        const char * comma = strchr(filter, ',');
+        const size_t length = comma != NULL ? (size_t) (comma - filter) : strlen(filter);
+        if (strlen(name) == length && strncmp(name, filter, length) == 0) {
+            return true;
+        }
+        if (comma == NULL) {
+            break;
+        }
+        filter = comma + 1;
+    }
+    return false;
