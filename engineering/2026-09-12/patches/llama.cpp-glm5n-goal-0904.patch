+// Phase-1c helper: decide whether a node should run on a single thread without barriers.
+static int64_t ggml_cpu_single_task_max_elements(void) {
+    static int64_t v = -1;
+    if (v < 0) {
+        const char * env = getenv("GGML_CPU_SINGLE_TASK_MAX_ELEMENTS");
+        v = env != NULL ? atoll(env) : 32768;
+    }
+    return v;
