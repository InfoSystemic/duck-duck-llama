@@ -1,6 +1,7 @@
 from __future__ import annotations
 
 import json
+import os
 import re
 from pathlib import Path
 
@@ -1018,3 +1019,122 @@ class DeepseekV4DSparkModel(DeepseekV4Model):
 
         self.gguf_writer.add_block_size(self.hparams["dspark_block_size"])
         self.gguf_writer.add_target_layers([layer + 1 for layer in self.hparams["dspark_target_layer_ids"]])
+
+@ModelBase.register("DeepseekV41ForCausalLM")
+@ModelBase.example("deepseek-ai/DeepSeek-V4.1-Flash")
+class DeepseekV41Model(DeepseekV4Model):
+    """DeepSeek-V4.1-Flash.
+
+    V4.1 reuses the V4 backbone verbatim -- same reference-style tensor naming
+    (`layers.N.attn.wq_a.weight`, `layers.N.ffn.experts.E.w1.{weight,scale}`, `hc_*`),
+    the same hyper-connection/Sinkhorn block, the same lightning indexer, the same
+    o_groups/o_lora output factorisation and the same MXFP4 experts. Verified against
+    DeepSeek-V4-Flash-0731, whose GGUF carries identical
+    `hyper_connection.{count=4,sinkhorn_iterations=20,epsilon=1e-6}` and
+    `attention.indexer.top_k=512` values.
+
+    Three things differ, and only the tensor side needs code here:
+      * config is nested under `text_config` -- ModelBase already flattens that.
+      * two layers (`engram_layer_ids`) carry Engram lookup tables. There is no Engram
+        graph in any engine yet, so ENGRAM_SKIP=1 drops them and produces a
+        SPEED-ONLY model: valid for decode-rate measurement, NOT for quality.
+      * a vision tower + aligner, dropped here (text-only conversion).
+    """
+
+    model_arch = gguf.MODEL_ARCH.DEEPSEEK4   # reuse the V4 graph
+
+    _V41_DROP = re.compile(
+        r"^(vision\.|aligner\.|image_(start|end|newline)$)"
+    )
+    _V41_ENGRAM = re.compile(r"(^|\.)engram(\.|$)")
+
+    # V4.1 splits the indexer key path into its own projection + norm. Both already have
+    # MODEL_TENSOR ids and both are consumed by the existing deepseek4 graph; the V4
+    # layer_map simply predates them.
+    _V41_EXTRA_MAP = {
+        "attn.indexer.k_norm.weight": (gguf.MODEL_TENSOR.INDEXER_K_NORM, ".weight"),
+        "attn.indexer.wk.weight":     (gguf.MODEL_TENSOR.INDEXER_ATTN_K, ".weight"),
+    }
+
+    # V4.1 has NO head-level hyper-connection mix: its only globals are embed/head/norm,
+    # while the deepseek4 graph requires output_hc_{fn,base,scale} (V4-Flash learns a
+    # head-level stream mix). They are ~80 KB total and contribute nothing measurable to
+    # decode cost, so V41_HC_HEAD_STUB=1 synthesises them for a SPEED-ONLY build.
+    _V41_HC_HEAD = {
+        "__v41_hc_head_fn":    gguf.MODEL_TENSOR.HC_HEAD_FN,
+        "__v41_hc_head_base":  gguf.MODEL_TENSOR.HC_HEAD_BASE,
+        "__v41_hc_head_scale": gguf.MODEL_TENSOR.HC_HEAD_SCALE,
+    }
+
+    def generate_extra_tensors(self):
+        # CRITICAL: the parent's generate_extra_tensors() is where the MXFP4 routed experts
+        # are merged and written. Overriding it without chaining silently drops every expert
+        # tensor (32.3 GB -> 3.4 GB, 102 -> 93 tensors).
+        yield from super().generate_extra_tensors()
+        if os.environ.get("V41_HC_HEAD_STUB", "0") == "0":
+            return
+        hc_mult = int(self.hparams["hc_mult"])
+        hc_dim = hc_mult * int(self.hparams["hidden_size"])
+        for nm, shape in (("__v41_hc_head_fn", (hc_mult, hc_dim)),
+                          ("__v41_hc_head_base", (hc_mult,)),
+                          ("__v41_hc_head_scale", (1,))):
+            self._dsv4_f32_tensors.add(nm)
+            yield nm, torch.zeros(*shape, dtype=torch.float32)
+
+        # V4.1 dropped the compressor's absolute position embedding: it ships
+        # compressor.{wkv,wgate,norm} but no `.ape`, while the deepseek4 graph requires all
+        # four whenever compress_ratios[i] != 0. A ZERO ape is the semantically faithful
+        # stand-in for "no APE". ggml shape {coff * n_embd_head, ratio}; coff = 2 iff ratio == 4.
+        ratios = self.hparams.get("compress_ratios") or []
+        n_embd_head = int(self.hparams.get("head_dim") or 0)
+        for bid, ratio in enumerate(ratios[:self.block_count]):
+            if not ratio:
+                continue
+            if f"layers.{bid}.attn.compressor.ape" in self.model_tensors:
+                continue
+            coff = 2 if ratio == 4 else 1
+            nm = f"__v41_ape.{bid}"
+            self._dsv4_f32_tensors.add(nm)
+            yield nm, torch.zeros(int(ratio), coff * n_embd_head, dtype=torch.float32)
+
+    def _map_dsv4_tensor_name(self, name: str, bid):
+        if name in self._V41_HC_HEAD:
+            return self._V41_HC_HEAD[name], ".weight"
+        match = re.match(r"layers\.(\d+)\.(.+)$", name)
+        if match is not None and match.group(2) in self._V41_EXTRA_MAP:
+            return self._V41_EXTRA_MAP[match.group(2)]
+        return super()._map_dsv4_tensor_name(name, bid)
+
+    def modify_tensors(self, data_torch, name: str, bid):
+        if name in self._V41_HC_HEAD:
+            key, suffix = self._map_dsv4_tensor_name(name, None)
+            return [(self.format_tensor_name(key, None, suffix), data_torch)]
+        if name.startswith("__v41_ape."):
+            ape_bid = int(name.split(".")[1])
+            return [(self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_COMPRESSOR_APE, ape_bid, ".weight"), data_torch)]
+        if self._V41_DROP.match(name):
+            return []
+        # V4.1 rebuilt the indexer key path: it has `indexer.wk` + `indexer.k_norm` where V4
+        # had an `indexer.compressor.*` block, and it dropped `attn.compressor.ape`. The
+        # deepseek4 graph still builds indexer keys the V4 way, so INDEXER_SKIP=1 drops the
+        # indexer entirely for a short-context SPEED build (the indexer is a no-op anyway
+        # while n_kv <= index_topk, which is 512).
+        if ".indexer." in name or name.endswith(".compressor.ape"):
+            if os.environ.get("INDEXER_SKIP", "0") != "0":
+                return []
+        # With NO_COMPRESS the config sets every compress_ratio to 0, so the graph creates no
+        # compressor tensors at all and any left in the file are "wrong number of tensors".
+        if ".compressor." in name and os.environ.get("NO_COMPRESS", "0") != "0":
+            return []
+        if self._V41_ENGRAM.search(name):
+            if os.environ.get("ENGRAM_SKIP", "0") != "0":
+                return []
+            raise ValueError(
+                f"Engram tensor {name!r} has no graph implementation yet; "
+                f"set ENGRAM_SKIP=1 for a speed-only conversion"
+            )
+        # vision-language routing bias; the text-only graph has no consumer for it
+        if name.endswith("ffn.gate.bias_vl"):
+            return []
+        return super().modify_tensors(data_torch, name, bid)
+
diff --git a/docs/backend/CPU-NUMA.md b/docs/backend/CPU-NUMA.md
new file mode 100644
index 0000000000000000000000000000000000000000..8a36b27b5827fd3d6af00a9d791d7922b861e8bf
--- /dev/null
+++ b/docs/backend/CPU-NUMA.md
@@ -0,0 +1,95 @@
+# Linux NUMA CPU devices
+
+The CPU backend can optionally expose one selectable device per Linux NUMA
+node. This makes the existing Meta tensor-split backend usable across CPU
+sockets while keeping weights and worker threads local to each node.
+
+The feature is disabled by default. Set the environment before the process
+starts:
+
+| Variable | Default | Purpose |
+| --- | ---: | --- |
+| `GGML_CPU_NUMA_DEVICES` | off | Expose `CPU-NUMA0`, `CPU-NUMA1`, ... devices. |
+| `GGML_CPU_NUMA_THREADS` | min(10, physical cores/node) | Physical worker cores used by each device. |
+| `GGML_CPU_NUMA_POLL` | 50 | Thread-pool polling level, capped at 100. |
+| `GGML_CPU_NUMA_HUGEPAGES` | off | Apply `MADV_HUGEPAGE` to node-local mappings. Benchmark before enabling. |
+| `GGML_CPU_NUMA_DIRECT_ALLREDUCE` | off | Use the direct host-memory F32 collective when supported. |
+
+Device discovery respects the process CPU-affinity mask and selects one
+logical CPU per physical core. Buffers are allocated with a strict Linux
+`mbind()` policy. Device memory reporting is node-local and includes
+reclaimable file cache rather than reporting total host RAM for every node.
+
+## Server example
+
+```bash
+export GGML_CPU_NUMA_DEVICES=1
+export GGML_CPU_NUMA_THREADS=12
+export GGML_CPU_NUMA_POLL=100
+export GGML_CPU_NUMA_DIRECT_ALLREDUCE=1
+
+llama-server \
+  --model "$MODEL" \
+  --gpu-layers all \
+  --device CPU-NUMA0,CPU-NUMA1,CPU-NUMA2,CPU-NUMA3 \
+  --split-mode tensor \
+  --tensor-split 1,1,1,1 \
+  --fit off \
+  --threads 12 \
+  --threads-batch 12
+```
+
+`llama-bench` uses `/` between values because commas select parameter sweep
+values:
+
+```bash
+llama-bench \
+  --model "$MODEL" \
+  --n-prompt 0 \
+  --n-gen 32 \
+  --repetitions 3 \
+  --threads 12 \
+  --n-gpu-layers 999 \
+  --device CPU-NUMA0/CPU-NUMA1/CPU-NUMA2/CPU-NUMA3 \
+  --split-mode tensor \
+  --tensor-split 1/1/1/1
+```
+
+## Direct all-reduce contract
+
+The direct collective is deliberately narrow. It activates only when every
+backend is a `CPU-NUMA*` device and every reduction tensor is contiguous F32,
+has the same shape, and belongs to its corresponding NUMA device. It waits for
+all socket workers, reduces directly through host-addressable memory, and
+replicates the result. Any unsupported type, layout, or backend returns to the
+Meta backend's generic butterfly implementation.
+
+Meta host-backed buffers still require per-device view mapping. Treating a
+Meta buffer as an ordinary host buffer can leak its placeholder address into a
+worker graph, notably for hybrid recurrent-state views. The Meta backend also
+establishes a completion boundary before graph metadata can be recycled by the
+scheduler.
+
+## Example measurements
+
+The following decode-only results used a 27.3B, 31.45 GB GGUF on four Intel
+Xeon Gold 6242 sockets. Each value is the mean of three 32-token runs with Q8_0
+KV cache and Flash Attention enabled.
+
+| Configuration | Tokens/s |
+| --- | ---: |
+| One NUMA device, 16 cores | 2.524 |
+| Four devices, generic collective, 16 cores/socket | 5.239 |
+| Four devices, direct collective, 16 cores/socket | 6.091 |
+| Direct collective, 10 cores/socket, poll 50 | 6.783 |
+| Direct collective, 12 cores/socket, poll 50 | 7.054 |
+| Direct collective, 12 cores/socket, poll 100 | **7.169** |
+| Same peak profile with huge-page advice | 6.989 |
+
+The direct-collective output matched the generic fallback byte-for-byte for a
+fixed-seed greedy generation. In a production-style MTP smoke test, the same
+12-core profile generated 14.06-14.27 tokens/s with 90-94% draft acceptance;
+the exact-output validation completed correctly.
+
+Core count, polling, and huge pages are workload- and platform-dependent.
+Measure them independently for each model and quantization.
