+static bool ggml_cpu_node_is_single_task(const struct ggml_tensor * node, int n_threads) {
+    if (n_threads <= 1) {
+        return true;
+    }
+    if (ggml_get_n_tasks((struct ggml_tensor *) node, n_threads) == 1) {
+        return true;
+    }
+    const int64_t max_el = ggml_cpu_single_task_max_elements();
+    if (max_el <= 0) {
+        return false;
+    }
+    switch (node->op) {
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+        case GGML_OP_SCALE:
+        case GGML_OP_NORM:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_L2_NORM:
+        case GGML_OP_GLU:
+        case GGML_OP_UNARY:
+        case GGML_OP_CONCAT:
+        case GGML_OP_SOFT_MAX:
+        case GGML_OP_ARGSORT:
+        case GGML_OP_TOP_K:
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+        case GGML_OP_DUP:
+        case GGML_OP_ROPE:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_CLAMP:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_ADD_ID:
+            break;
+        default:
+            return false;
+    }
+    int64_t n = ggml_nelements(node);
+    for (int i = 0; i < GGML_MAX_SRC; i++) {
+        if (node->src[i] != NULL) {
+            const int64_t ns = ggml_nelements(node->src[i]);
+            if (ns > n) {
+                n = ns;
+            }
+        }
+    }
+    return n <= max_el;
+}
