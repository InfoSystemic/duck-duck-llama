+void common_model_residency_log(const char * role, const llama_context * ctx) {
+    struct device_residency {
+        ggml_backend_dev_t dev;
+        size_t model_bytes = 0;
+    };
+
+    std::vector<device_residency> devices;
+    for (const auto & [buft, memory] : llama_get_memory_breakdown(ctx)) {
+        if (ggml_backend_buft_is_host(buft)) {
+            continue;
+        }
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev == nullptr) {
+            continue;
+        }
+        const enum ggml_backend_dev_type type = ggml_backend_dev_type(dev);
+        if (type != GGML_BACKEND_DEVICE_TYPE_GPU && type != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            continue;
+        }
+        const auto it = std::find_if(devices.begin(), devices.end(), [dev](const device_residency & item) {
+            return item.dev == dev;
+        });
+        if (it == devices.end()) {
+            devices.push_back({dev, memory.model});
+        } else {
+            it->model_bytes += memory.model;
+        }
+    }
+
+    for (const auto & item : devices) {
+        const enum ggml_backend_dev_type type = ggml_backend_dev_type(item.dev);
+        LOG_INF("wildspeed_model_residency role=%s device=%s device_type=%s model_bytes=%zu\n",
+                role,
+                ggml_backend_dev_name(item.dev),
+                type == GGML_BACKEND_DEVICE_TYPE_IGPU ? "IGPU" : "GPU",
+                item.model_bytes);
+    }
+}
