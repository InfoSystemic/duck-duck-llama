+static bool test_copy_with_tensor_override() {
+    llama_quant_model_desc desc = {};
+    desc.architecture = "llama";
+    desc.n_embd       = 4096;
+    desc.n_ff         = 4096;
+    desc.n_layer      = 43;
+    desc.n_head       = 32;
+    desc.n_head_kv    = 8;
+    desc.n_expert     = 256;
+
+    llama_model * model = llama_quant_model_from_metadata(&desc);
+
+    const llama_model_tensor_override overrides[] = {
+        { "^blk\\.28\\.ffn_(gate|down|up)_exps\\.weight$", GGML_TYPE_Q2_K },
+        { nullptr, GGML_TYPE_COUNT },
+    };
+    llama_model_quantize_params qparams = llama_model_quantize_default_params();
+    qparams.only_copy        = true;
+    qparams.allow_requantize = true;
+    qparams.tt_overrides     = overrides;
+
+    quantize_state_impl * qs = llama_quant_init(model, &qparams);
+
+    struct ggml_init_params params = { 2 * ggml_tensor_overhead(), nullptr, true };
+    ggml_context_ptr ctx(ggml_init(params));
+    ggml_tensor * selected = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_MXFP4, 4096, 2048, 256);
+    ggml_tensor * copied   = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_MXFP4, 4096, 2048, 256);
+    ggml_set_name(selected, "blk.28.ffn_gate_exps.weight");
+    ggml_set_name(copied,   "blk.27.ffn_gate_exps.weight");
+
+    ggml_tensor * tensors[] = { selected, copied };
+    ggml_type result_types[2] = { GGML_TYPE_COUNT, GGML_TYPE_COUNT };
+    llama_quant_compute_types(qs, LLAMA_FTYPE_ALL_F32, tensors, result_types, 2);
+
+    const bool pass =
+        llama_quant_tensor_allows_quantization(qs, selected) &&
+        !llama_quant_tensor_allows_quantization(qs, copied) &&
+        result_types[0] == GGML_TYPE_Q2_K &&
+        result_types[1] == GGML_TYPE_MXFP4;
+
+    printf("  %s  COPY preserves unselected tensors and applies explicit override\n", pass ? "PASS" : "FAIL");
+    llama_quant_free(qs);
+    llama_model_free(model);
+    return pass;
+}
