+#if defined(__AVX2__)
+static inline __m256 load_mxfp4_e8m0_8_gather_repacked(const uint8_t * e) {
+    const __m128i order = _mm_setr_epi8(0, 4, 1, 5, 2, 6, 3, 7,
+                                       -1, -1, -1, -1, -1, -1, -1, -1);
+    const __m128i packed = _mm_shuffle_epi8(
+            _mm_loadl_epi64((const __m128i *) e), order);
+    const __m256i index = _mm256_cvtepu8_epi32(packed);
+    return _mm256_i32gather_ps(ggml_table_f32_e8m0_half, index, sizeof(float));
+}
+
+static inline __m256 load_mxfp4_e8m0_8_bits_repacked(const uint8_t * e) {
+    const __m128i order = _mm_setr_epi8(0, 4, 1, 5, 2, 6, 3, 7,
+                                       -1, -1, -1, -1, -1, -1, -1, -1);
+    const __m128i packed = _mm_shuffle_epi8(
+            _mm_loadl_epi64((const __m128i *) e), order);
+    const __m256i exponent = _mm256_cvtepu8_epi32(packed);
+
+    // E8M0 values are powers of two.  MXFP4 consumes half of the encoded
+    // scale, so normal values map directly to exponent (e - 1).  Preserve
+    // the exact denormal encodings for e=0 and e=1 without a table lookup.
+    const __m256i normal = _mm256_slli_epi32(
+            _mm256_sub_epi32(exponent, _mm256_set1_epi32(1)), 23);
+    const __m256i denormal = _mm256_sllv_epi32(
+            _mm256_set1_epi32(0x00200000), exponent);
+    const __m256i is_denormal = _mm256_cmpgt_epi32(
+            _mm256_set1_epi32(2), exponent);
+    return _mm256_castsi256_ps(
+            _mm256_blendv_epi8(normal, denormal, is_denormal));
+}
+
+static void verify_mxfp4_e8m0_8_bits_repacked() {
+    static constexpr int order[8] = { 0, 4, 1, 5, 2, 6, 3, 7 };
+    alignas(32) float actual[8];
+
+    for (int base = 0; base < 256; base += 8) {
+        uint8_t encoded[8];
+        for (int lane = 0; lane < 8; ++lane) {
+            encoded[lane] = (uint8_t) (base + lane);
+        }
+        _mm256_store_ps(actual, load_mxfp4_e8m0_8_bits_repacked(encoded));
+
+        for (int lane = 0; lane < 8; ++lane) {
+            const float expected = ggml_e8m0_to_fp32_half(encoded[order[lane]]);
+            uint32_t actual_bits;
+            uint32_t expected_bits;
+            memcpy(&actual_bits, &actual[lane], sizeof(actual_bits));
+            memcpy(&expected_bits, &expected, sizeof(expected_bits));
+            GGML_ASSERT(actual_bits == expected_bits);
+        }
+    }
+}
+
+static int mxfp4_gather_scale_mode() {
+    static const int mode = [] {
+        const char * value = std::getenv("GGML_CPU_MXFP4_GATHER_SCALE");
+        const int selected = value != nullptr ? std::atoi(value) : 0;
+        if (selected == 3 || selected == 4) {
+            verify_mxfp4_e8m0_8_bits_repacked();
+        }
+        return selected;
+    }();
+    return mode;
+}
